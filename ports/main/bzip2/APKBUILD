# Maintainer: visorjs <info@visorjs.com>
pkgname=bzip2
pkgver=1.0.8
# wasm64: aports is at -r6; this repo's rebuild counter starts fresh, as
# every other recipe here does.
pkgrel=8
pkgdesc="A high-quality data compression program"
url="https://sourceware.org/bzip2/"
arch="wasm64"
license="bzip2-1.0.6"
# wasm64: aports carries no depends/depends_dev at all and lets tracedeps
# derive them from the ELF .so edges. Here they are spelled out: tracedeps
# adds no version, and wasm packages need the musl floor. bzip2/bzip2recover
# link libbz2.a statically (upstream's Makefile does `-L. -lbz2` against the
# archive), so the main package needs only libc; -dev owns the
# usr/lib/libbz2.so symlink and so needs the shared library in libbz2.
depends="musl>=1.2.6-r28"
depends_dev="$pkgname=$pkgver-r$pkgrel libbz2=$pkgver-r$pkgrel"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc libbz2"
options="!check !strip !archcheck"
# wasm64: saneso.patch is dropped. It rewrites only the link recipe inside
# Makefile-libbz2_so (`$(CC) -shared -Wl,-soname,libbz2.so.1`), and that
# makefile is not run here — see build(). The soname it exists to fix is
# passed directly to reactor-link instead.
source="https://sourceware.org/pub/bzip2/bzip2-$pkgver.tar.gz
	bzip2-1.0.4-makefile-CFLAGS.patch
	bzip2-1.0.4-man-links.patch
	bzip2-1.0.2-progress.patch
	bzip2-1.0.3-no-test.patch
	bzip2.pc.in
	"

_sover=1

# secfixes:
#   1.0.6-r7:
#     - CVE-2019-12900
#   1.0.6-r5:
#     - CVE-2016-3189

prepare() {
	default_prepare

	# Fix man path
	# Generate relative symlinks
	sed -i \
		-e 's:\$(PREFIX)/man:\$(PREFIX)/share/man:g' \
		-e 's:ln -s -f $(PREFIX)/bin/:ln -s :' \
		Makefile

	# fixup broken version stuff
	sed -i \
		-e "s:1\.0\.4:$pkgver:" \
		bzip2.1 bzip2.txt Makefile-libbz2_so manual.*
}

# wasm64: aports runs `make -f Makefile-libbz2_so all` for the shared half.
# That makefile links with `$(CC) -shared -Wl,-soname -Wl,...`, which
# wasm-ld does not accept, and it also builds a `bzip2-shared` binary that
# aports never installs. The shared object is therefore linked by hand with
# reactor-link out of the archive `make all` already produced — the same
# shape zlib, sqlite and libunistring use here — and bzip2-shared is not
# built at all. The static half is upstream's own Makefile, unchanged.
build() {
	# Upstream's Makefile hardcodes CC=gcc / AR=ar / RANLIB=ranlib, which
	# override the environment, so the toolchain is passed on the command
	# line. CFLAGS is *not* passed there: bzip2-1.0.4-makefile-CFLAGS.patch
	# turns the assignment into `CFLAGS+=`, which appends to the exported
	# CFLAGS from ports/abuild.conf; a command-line CFLAGS would replace it
	# and lose -D_FILE_OFFSET_BITS=64.
	make CC="$CC" AR=llvm-ar RANLIB=llvm-ranlib all

	$LD --entry-shape=shared --soname libbz2.so.$_sover \
		-Wl,--whole-archive libbz2.a -Wl,--no-whole-archive \
		"$REACTOR_SYSROOT/lib/libc.so" \
		-o libbz2.so.$pkgver
}

package() {
	make PREFIX="$pkgdir"/usr install
	install -D libbz2.so.$pkgver "$pkgdir"/usr/lib/libbz2.so.$pkgver
	ln -s libbz2.so.$pkgver "$pkgdir"/usr/lib/libbz2.so
	ln -s libbz2.so.$pkgver "$pkgdir"/usr/lib/libbz2.so.${pkgver%%.*}

	mkdir -p "$pkgdir"/usr/lib/pkgconfig/
	sed "s|@VERSION@|$pkgver|" "$srcdir"/bzip2.pc.in \
		> "$pkgdir"/usr/lib/pkgconfig/bzip2.pc
}

libbz2() {
	pkgdesc="Shared library for bz2"
	# wasm64: tracedeps adds no version; the musl floor is named.
	depends="musl>=1.2.6-r28"
	mkdir -p "$subpkgdir"/usr/lib
	mv "$pkgdir"/usr/lib/*.so.* "$subpkgdir"/usr/lib/
}

