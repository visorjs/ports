# Maintainer: visorjs <info@visorjs.com>
pkgname=nano
pkgver=9.2
pkgrel=8
pkgdesc="Enhanced clone of the Pico text editor"
url="https://www.nano-editor.org/"
arch="wasm64"
license="GPL-3.0-or-later"
options="!check !strip !archcheck"
depends="musl>=1.2.6-r28 libncursesw"
subpackages="$pkgname-doc $pkgname-syntax:syntax:noarch"
source="https://www.nano-editor.org/dist/v${pkgver%%.*}/nano-$pkgver.tar.xz"
builddir="$srcdir/$pkgname-$pkgver"

_stage_deps() {
	local deps="$srcdir/deps-staged"
	apk add --root "$deps" --initdb --no-scripts --no-chown \
		--arch "$CARCH" --keys-dir "${VISORJS_APK_KEYS:-/work/ports/keys}" \
		--repository "$REPODEST/main" \
		musl ncurses-dev libncursesw linux-headers pkgconf \
		|| die "staging the dependency root failed"

	export CFLAGS="$CFLAGS -D_GNU_SOURCE -I$deps/usr/include -I$deps/usr/include/ncursesw"
	export CPPFLAGS="$CPPFLAGS -D_GNU_SOURCE -I$deps/usr/include -I$deps/usr/include/ncursesw"
	export LDFLAGS="$LDFLAGS -L$deps/usr/lib"
	export PKG_CONFIG_PATH="$deps/usr/lib/pkgconfig:$deps/usr/share/pkgconfig"
	export PKG_CONFIG_LIBDIR="$deps/usr/lib/pkgconfig:$deps/usr/share/pkgconfig"
}

build() {
	_stage_deps

	# wasm-ld rejects autoconf's `char f (void);` function probes on
	# signature mismatch; cache variables supply the true libc / ncurses answers.
	./configure \
		--build=$CBUILD \
		--host=$CARCH-alpine-linux-musl \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var \
		--disable-libmagic \
		--disable-nls \
		--enable-utf8 \
		ac_cv_func___fseterr=yes \
		gl_cv_onwards_func___fseterr=yes \
		ac_cv_func_btowc=yes \
		ac_cv_func_canonicalize_file_name=no \
		ac_cv_func_clock_getres=yes \
		ac_cv_func_clock_gettime=yes \
		ac_cv_func_clock_settime=yes \
		ac_cv_func_closedir=yes \
		ac_cv_func_dirfd=yes \
		ac_cv_func_error=no \
		ac_cv_func_faccessat=yes \
		ac_cv_func_fchdir=yes \
		ac_cv_func_fcntl=yes \
		ac_cv_func_flockfile=yes \
		ac_cv_func_fnmatch=yes \
		ac_cv_func_fstatat=yes \
		ac_cv_func_funlockfile=yes \
		ac_cv_func_futimens=yes \
		ac_cv_func_futimes=yes \
		ac_cv_func_futimesat=yes \
		ac_cv_func_getcwd=yes \
		ac_cv_func_getdelim=yes \
		ac_cv_func_getdtablesize=yes \
		ac_cv_func_getline=yes \
		ac_cv_func_getpwnam_r=yes \
		ac_cv_func_getprogname=no \
		ac_cv_func_getrandom=yes \
		ac_cv_func_gettimeofday=yes \
		ac_cv_func_glob=yes \
		ac_cv_func_isblank=yes \
		ac_cv_func_iswalnum=yes \
		ac_cv_func_iswalpha=yes \
		ac_cv_func_iswblank=yes \
		ac_cv_func_iswcntrl=yes \
		ac_cv_func_iswpunct=yes \
		ac_cv_func_lstat=yes \
		ac_cv_func_lutimes=yes \
		ac_cv_func_mbrtowc=yes \
		ac_cv_func_mbsinit=yes \
		ac_cv_func_mbsrtowcs=yes \
		ac_cv_func_mbstowcs=yes \
		ac_cv_func_mbtowc=yes \
		ac_cv_func_memrchr=yes \
		ac_cv_func_mkstemps=yes \
		ac_cv_func_nl_langinfo=yes \
		ac_cv_func_openat=yes \
		ac_cv_func_opendir=yes \
		ac_cv_func_pthread_sigmask=yes \
		ac_cv_func_raise=yes \
		ac_cv_func_rawmemchr=no \
		ac_cv_func_readdir=yes \
		ac_cv_func_readlink=yes \
		ac_cv_func_realpath=yes \
		ac_cv_func_sigaction=yes \
		ac_cv_func_sigprocmask=yes \
		ac_cv_func_snprintf=yes \
		ac_cv_func_strcasecmp=yes \
		ac_cv_func_strcasestr=yes \
		ac_cv_func_strncasecmp=yes \
		ac_cv_func_strnlen=yes \
		ac_cv_func_strnlen_working=yes \
		ac_cv_func_towlower=yes \
		ac_cv_func_utime=yes \
		ac_cv_func_utimensat=yes \
		ac_cv_func_vsnprintf=yes \
		ac_cv_func_wcrtomb=yes \
		ac_cv_func_wcslen=yes \
		ac_cv_func_wctomb=yes \
		ac_cv_func_wcwidth=yes \
		ac_cv_func_wmempcpy=no \
		gl_cv_func_fcntl_f_dupfd_cloexec=yes \
		gl_cv_func_fcntl_f_dupfd_works=yes \
		gl_cv_func_dup2_works=yes \
		gl_cv_func_getcwd_null=yes \
		gl_cv_func_getcwd_posix_signature=yes \
		gl_cv_func_getcwd_abort_bug=no \
		gl_cv_func_getcwd_path_max=yes \
		gl_cv_func_wcwidth_works=yes \
		gl_cv_func_wcwidth_macro=no \
		gl_cv_func_strcasestr_works_always=yes \
		gl_cv_func_working_getdelim=yes \
		ac_cv_lib_ncursesw_use_default_colors=yes \
		ac_cv_lib_ncursesw_set_escdelay=yes \
		ac_cv_lib_ncursesw_key_defined=yes \
		ac_cv_lib_ncursesw_wget_wch=yes
	make
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 doc/sample.nanorc \
		"$pkgdir"/etc/nanorc

	# Proper syntax highlighting for APKBUILDs
	sed -i "/syntax/s/\"$/\" \"APKBUILD&/" \
		"$pkgdir"/usr/share/nano/sh.nanorc
}

syntax() {
	pkgdesc="Syntax highlighting definitions for $pkgname"
	depends="$pkgname=$pkgver-r$pkgrel"

	amove usr/share/nano
}

