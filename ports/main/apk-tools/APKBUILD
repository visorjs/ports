# Maintainer: visorjs <info@visorjs.com>
pkgname=apk-tools
pkgver=3.0.7
pkgrel=8
# The tarball's SOVERSION file, which Makefile reads into SO_VERSION.
_sover=3.0.0
pkgdesc="Alpine package manager"
url="https://gitlab.alpinelinux.org/alpine/apk-tools"
arch="wasm64"
license="GPL-2.0-only"
depends="musl>=1.2.6-r28 zlib libcrypto3 libssl3 libapk"
# Host build tools, installed by build.sh (see there): upstream
# generates the help database and the shell completions by running
# src/genhelp.lua over the manpage sources (Make.rules looks for
# exactly lua5.3 or lua5.2), and the manpages themselves by running
# scdoc over them. Pinned exactly, like every other input here.
# Alpine's mirror keeps only the current pkgrel, so an upstream bump
# makes this `apk add` fail with "unable to select packages" — the fix
# is to bump the pin, not to unpin it.
#
# Two Alpine subpackages have no counterpart here: -dbg, because wasm
# objects are not ELF and there is no split-debug step to package (the
# same reason `!strip` is set), and -static, whose content is upstream's
# apk.static — a `-static`-linked ELF binary, which is not a shape this
# platform's linker produces (a wasm process binary links libc.a and is
# already self-contained; the -static subpackage below carries libapk.a
# instead, matching what upstream's `libs-y` builds). The zsh completion
# upstream ships is a checked-in file in a directory this tarball does
# not carry.
makedepends="lua5.3=5.3.6-r6 scdoc=1.11.4-r0"
subpackages="$pkgname-dev $pkgname-static $pkgname-doc
	$pkgname-bash-completion $pkgname-zsh-completion libapk"
options="!check !strip !archcheck"
source="https://gitlab.alpinelinux.org/alpine/apk-tools/-/archive/v$pkgver/apk-tools-v$pkgver.tar.gz"
builddir="$srcdir/apk-tools-v$pkgver"

# Upstream's own make build (Make.rules + src/Makefile + libfetch/Makefile)
# is reproduced here rather than run, because it hardcodes gcc/ld and
# resolves zlib/openssl through pkg-config against the host. What is
# reproduced, and where it comes from:
#
#   - CFLAGS_ALL from Make.rules, plus src/Makefile's -D_ATFILE_SOURCE
#     -Iportability -Isrc and (URL_BACKEND=libfetch) -Ilibfetch.
#   - CRYPTO=openssl and URL_BACKEND=libfetch, upstream's defaults:
#     crypto_openssl.c and io_url_libfetch.c, not their mbedtls/wget
#     alternatives.
#   - ZSTD is off, so io_zstd.o is not built and -DHAVE_ZSTD is not set
#     for adb_comp.c (upstream's `ZSTD=no`). zstd has no ports package.
#   - The object lists are upstream's libapk.so-objs + apk-objs +
#     libfetch.a-objs verbatim. apk-static.c is upstream's STATIC-only
#     alternative to apk.c and is excluded, as it is in a default build.
#   - src/help.h is generated by running upstream's own genhelp.lua over
#     the doc/apk*.8.scd manpages, exactly as src/Makefile's cmd_genhelp
#     does. (Its `#define NO_HELP` branch is the fallback for a build
#     host without lua, and produces an apk whose every --help says
#     "built without help".) genhelp.lua compresses the blob through
#     lua-zlib when present and otherwise pipes to the gzip binary,
#     which is the path taken here.
#   - portability/*.c is compiled only for the symbols this sysroot
#     actually lacks, by rerunning the same has_header_symbol probes
#     portability/meson.build performs (upstream's make build compiles
#     none of them, since glibc/musl provide all eleven). Empirically
#     the reactor libc provides all eleven too, so nothing under
#     portability/ compiles — but the probe stays, so a libc that
#     later loses one is handled rather than mystifying.
#   - -DAPK_CONFIG_ARCH is upstream's own arch override knob
#     (src/apk_arch.h); wasm64 is not a compile-time arch upstream
#     detects.
build() {
	local deps="$srcdir/deps"
	# A private root installed from the local signed repo: apk takes each
	# version from the index, so no version is written down twice. zlib,
	# libcrypto3 and libssl3 are named beside the -dev packages because
	# neither -dev depends on the runtime half that carries the .so.
	# --no-chown is what lets this run as the builder user abuild drops to,
	# and --no-scripts because a post-install script is #!/bin/sh and apk
	# runs it chrooted into a root with no shell. `die` only names the
	# failure; abuild's own `#!/bin/ash -e` already aborts on it.
	apk add --root "$deps" --initdb --no-scripts --no-chown \
		--arch "$CARCH" --keys-dir "${VISORJS_APK_KEYS:-/work/ports/keys}" \
		--repository "$REPODEST/main" \
		zlib zlib-dev libcrypto3 libssl3 openssl-dev \
		|| die "staging the dependency root failed"

	# The manpage set, from doc/Makefile's own scdocs-y list, which
	# names both the .8 applet pages and the .5 topic pages.
	local scdocs
	scdocs=$(sed -n '/^scdocs-y/,/^$/p' doc/Makefile |
		grep -oE 'apk[a-z_.-]*\.[0-9]' | sort -u)
	[ -n "$scdocs" ] || die "no manpages listed in doc/Makefile"
	local page scd_inputs=""
	for page in $scdocs; do
		scd_inputs="$scd_inputs doc/$page.scd"
	done

	# src/Makefile: $(obj)/help.h, cmd_genhelp. The obj dir is the src
	# dir in this in-tree build, which is where applet.c's #include
	# "help.h" looks. Upstream's two build systems feed this generator
	# differently — src/Makefile passes only doc/apk*.8.scd, meson passes
	# every manpage source — and meson's is the richer database and the
	# one Alpine builds, so the .5 topic pages go in too.
	LUA_PATH="src/?.lua" lua5.3 src/genhelp.lua $scd_inputs > src/help.h
	# Assert the real database, not upstream's no-lua fallback and not a
	# half-written file: genhelp_apk.lua's generate_help emits exactly
	# these two symbols, and the blob is tens of KB of compressed text.
	grep -q '^static const unsigned int uncompressed_help_size' src/help.h ||
		die "genhelp produced no help database (lua missing or failed)"
	grep -q '^static const unsigned char compressed_help\[\]' src/help.h ||
		die "genhelp produced no compressed help blob"
	[ "$(wc -c < src/help.h)" -gt 20000 ] ||
		die "generated help database is implausibly small"

	local port_defs="" port_srcs="" p sym csrc def hdr
	for p in \
		getrandom:getrandom.c:NEED_GETRANDOM:sys/random.h \
		memrchr:memrchr.c:NEED_MEMRCHR:string.h \
		memfd_create::NEED_MEMFD_CREATE:sys/mman.h \
		mknodat:mknodat.c:NEED_MKNODAT:sys/stat.h \
		pipe2:pipe2.c:NEED_PIPE2:unistd.h \
		qsort_r:qsort_r.c:NEED_QSORT_R:stdlib.h \
		reallocarray:reallocarray.c:NEED_REALLOCARRAY:stdlib.h \
		strchrnul:strchrnul.c:NEED_STRCHRNUL:string.h \
		strlcpy:strlcpy.c:NEED_STRLCPY:string.h \
		SOCK_CLOEXEC:socket.c:NEED_SOCK_CLOEXEC:sys/socket.h \
		unshare::NEED_UNSHARE:sched.h
	do
		sym=${p%%:*}; p=${p#*:}
		csrc=${p%%:*}; p=${p#*:}
		def=${p%%:*}; hdr=${p#*:}
		cat > "$srcdir/probe.c" <<-EOF
			#include <$hdr>
			int main(void) {
			#ifndef $sym
				(void) $sym;
			#endif
				return 0;
			}
		EOF
		$CC -D_GNU_SOURCE -fsyntax-only "$srcdir/probe.c" 2>/dev/null && continue
		msg "portability: $hdr lacks $sym, defining $def"
		port_defs="$port_defs -D$def"
		[ -z "$csrc" ] || port_srcs="$port_srcs portability/$csrc"
	done

	local cf="-Wall -Wstrict-prototypes -D_GNU_SOURCE -D_FILE_OFFSET_BITS=64"
	cf="$cf -std=gnu11 -O2 -D_ATFILE_SOURCE -Iportability -Isrc -Ilibfetch"
	cf="$cf -I$deps/usr/include -DAPK_CONFIG_ARCH=\"$CARCH\" $port_defs"

	# src/Makefile: libapk.so.$(SO_VERSION)-objs
	local libapk_objs="adb adb_comp adb_walk_adb apk_adb atom balloc blob
		commit common context crypto crypto_openssl ctype database hash
		extract_v2 extract_v3 fs_fsys fs_uvol io io_gunzip io_url_libfetch
		tar package pathbuilder print process query repoparser serialize
		serialize_json serialize_query serialize_yaml solver trust version"
	# src/Makefile: apk-objs
	local apk_objs="apk app_adbdump app_adbgen app_adbsign app_add app_audit
		app_cache app_convdb app_convndx app_del app_dot app_extract
		app_fetch app_fix app_index app_info app_list app_manifest app_mkndx
		app_mkpkg app_policy app_query app_update app_upgrade app_search
		app_stats app_verify app_version applet"
	# libfetch/Makefile: libfetch.a-objs
	local fetch_objs="common fetch http openssl-compat"

	# Fresh object dir: the link globs obj/*.o, so a leftover object
	# from an earlier run in the same $srcdir would be linked in.
	# Fresh object dirs: each link globs a directory, so a leftover
	# object from an earlier run in the same $srcdir would be linked in.
	# lib/ holds libapk's objects plus libfetch's, which upstream folds
	# into libapk.so through libapk.so-libs; bin/ holds the apk
	# utility's.
	rm -rf obj
	mkdir -p obj/lib obj/bin
	local f extra
	for f in $libapk_objs; do
		$CC $cf -c "src/$f.c" -o "obj/lib/src_$f.o"
	done
	for f in $apk_objs; do
		# src/Makefile: CFLAGS_apk.o
		extra=""
		[ "$f" = apk ] && extra="-DAPK_VERSION=\"$pkgver\""
		$CC $cf $extra -c "src/$f.c" -o "obj/bin/src_$f.o"
	done
	for f in $fetch_objs; do
		# libfetch/Makefile: CFLAGS_common.o, CONFDIR=/etc/apk
		extra=""
		[ "$f" = common ] && extra="-DCA_CERT_FILE=\"/etc/apk/ca.pem\"
			-DCA_CRL_FILE=\"/etc/apk/crl.pem\"
			-DCLIENT_CERT_FILE=\"/etc/apk/cert.pem\"
			-DCLIENT_KEY_FILE=\"/etc/apk/cert.key\""
		$CC $cf $extra -c "libfetch/$f.c" -o "obj/lib/fetch_$f.o"
	done
	for f in $port_srcs; do
		$CC $cf -c "$f" -o "obj/lib/port_$(basename "$f" .c).o"
	done

	# The same split upstream's src/Makefile builds: libapk carrying the
	# library objects, and the apk utility linked against it, with
	# src/Makefile's LDFLAGS_libapk.so.$(SO_VERSION) soname.
	$LD --entry-shape=shared --soname libapk.so.$_sover obj/lib/*.o \
		"$deps/usr/lib/libz.so" \
		"$deps/usr/lib/libssl.so.3" "$deps/usr/lib/libcrypto.so.3" \
		"$REACTOR_SYSROOT/lib/libc.so" -o libapk.so
	llvm-ar rcs libapk.a obj/lib/*.o
	# --entry-shape=dynamic links libc.so at load time, matching every
	# other wasm end-binary.
	$LD --entry-shape=dynamic obj/bin/*.o libapk.so \
		"$deps/usr/lib/libz.so" \
		"$deps/usr/lib/libssl.so.3" "$deps/usr/lib/libcrypto.so.3" \
		-o apk

	# doc/Makefile: one scdoc run per page in scdocs-y.
	for page in $scdocs; do
		scdoc < "doc/$page.scd" > "doc/$page"
	done

	# src/meson.build: generated_bash_completion and
	# generated_zsh_completion, the same generator as help.h with a
	# different format.
	LUA_PATH="src/?.lua" lua5.3 src/genhelp.lua --format=bash $scd_inputs > _apk
	LUA_PATH="src/?.lua" lua5.3 src/genhelp.lua --format=zsh $scd_inputs > _apk_zsh

	# src/Makefile: generate-y += apk.pc, from apk.pc.in through the
	# @SUBST@ rule in Make.rules.
	# @LIB_DIR@ is apk.pc's -L path, so it follows libapk to /usr/lib —
	# where Alpine's meson-built apk.pc also points it.
	sed -e 's|@EXEC_DIR@|/sbin|' \
		-e 's|@LIB_DIR@|/usr/lib|' \
		-e 's|@INCLUDE_DIR@|/usr/include|' \
		-e "s|@VERSION@|$pkgver|" \
		src/apk.pc.in > apk.pc
}

package() {
	install -D -m755 apk "$pkgdir/sbin/apk"
	install -D -m755 libapk.so "$pkgdir/usr/lib/libapk.so.$_sover"
	ln -s libapk.so.$_sover "$pkgdir/usr/lib/libapk.so"
	install -D -m644 libapk.a "$pkgdir/usr/lib/libapk.a"
	install -D -m644 apk.pc "$pkgdir/usr/lib/pkgconfig/apk.pc"
	# The directory set Alpine's package() creates. /lib/apk is apk's
	# database, not a library path, and stays there as upstream has it.
	install -d "$pkgdir/lib/apk/db" "$pkgdir/lib/apk/exec" \
		"$pkgdir/etc/apk/keys" "$pkgdir/etc/apk/protected_paths.d" \
		"$pkgdir/var/cache/apk"

	# src/meson.build: libapk_headers, the public list. src/*.h also
	# holds apk_applet.h, apk_nproc.h, apk_process.h, apk_solver_data.h's
	# private siblings and the generated help.h, none of which upstream
	# installs.
	local h
	install -d "$pkgdir/usr/include/apk"
	for h in $(sed -n '/^libapk_headers = \[/,/^]/p' src/meson.build |
		sed -n "s/^\t'\(.*\)',\$/\1/p"); do
		install -m644 "src/$h" "$pkgdir/usr/include/apk/$h"
	done
	[ "$(ls "$pkgdir/usr/include/apk" | wc -l)" -eq 25 ] ||
		die "expected upstream's 25 public headers"

	install -D -m644 _apk \
		"$pkgdir/usr/share/bash-completion/completions/_apk"
	install -D -m644 _apk_zsh "$pkgdir/usr/share/zsh/site-functions/_apk"

	local m
	for m in doc/apk*.[0-9]; do
		install -D -m644 "$m" "$pkgdir/usr/share/man/man${m##*.}/${m##*/}"
	done
}

libapk() {
	pkgdesc="Alpine package manager library"
	depends="musl>=1.2.6-r28 zlib libcrypto3 libssl3"
	amove usr/lib/libapk.so.*
}

sha512sums="4dfeea50e931808c7301f3353a26599defe1a8daaa3fa5551c781bbf6cc72cdd702428ff6ec9880aa4b87f0b2345395e0837fda84ad2bc49ea1d4b3866461035  apk-tools-v3.0.7.tar.gz"
