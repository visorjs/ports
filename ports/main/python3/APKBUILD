package() {
	make -j1 DESTDIR="$pkgdir" EXTRA_CFLAGS="$CFLAGS" install maninstall
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE

	install -Dm644 "$srcdir"/externally-managed \
		"$pkgdir"/usr/lib/python$_basever/EXTERNALLY-MANAGED

	# wasm64: build() puts the staged sysroot on CPPFLAGS/LDFLAGS so
	# configure can see it.  Those paths exist only in this container, so
	# strip every token naming them from the files a later consumer reads
	# back — otherwise each extension pip builds on the guest is handed an
	# -I and -L pointing at nothing.  Any token containing the staged root
	# goes, which covers CPPFLAGS/LDFLAGS, CONFIGURE_* and the recorded
	# PKG_CONFIG_* search lists alike; the doubled spaces left behind are
	# then squeezed.
	local f
	for f in "$pkgdir"/usr/lib/python$_basever/_sysconfigdata__*.py \
		"$pkgdir"/usr/lib/python$_basever/_sysconfig_vars__*.json \
		"$pkgdir"/usr/lib/python$_basever/config-$_basever*/Makefile \
		"$pkgdir"/usr/lib/pkgconfig/python-$_basever*.pc \
		"$pkgdir"/usr/bin/python$_basever-config; do
		[ -f "$f" ] || continue
		sed -i -E -e "s#[^ '\"]*deps-staged[^ '\"]*##g" \
			-e "s#  +# #g" "$f"
	done

	ln -s python3 "$pkgdir"/usr/bin/python
	ln -s python3-config "$pkgdir"/usr/bin/python-config

	# wasm64: idle icons and .desktop file dropped (no idle subpackage,
	# no Tkinter/X11 on this platform).
}

dev() {
	default_dev

	# pyconfig.h is needed runtime so we move it back
	mkdir -p "$pkgdir"/usr/include/python$_basever
	mv "$subpkgdir"/usr/include/python$_basever/pyconfig.h \
		"$pkgdir"/usr/include/python$_basever/
}

# wasm64: idle() dropped (no Tkinter/X11 on this platform).

tests() {
	pkgdesc="The test modules from the main python package"
	# wasm64: python3-tkinter-tests provider dropped (no tkinter).

	amove usr/lib/python$_basever/test
}

_pyc_meta() {
	pkgdesc="Meta package for pulling in all -pyc packages"
	depends=""
	mkdir -p "$subpkgdir"
}

_default_pyc() {
	pkgdesc="$pkgdesc (install .pyc cache files)"
	install_if="$pkgname=$pkgver-r$pkgrel"
	# wasm64: python3-tkinter-pyc provider dropped (no tkinter).
	depends="
		$pkgname-pycache-pyc0=$pkgver-r$pkgrel
		pyc
		"

	mkdir -p "$subpkgdir"
}

pyc0() {
	pkgdesc="$pkgdesc (.pyc pycache files)"
	depends=""

	cd "$pkgdir"
	amove $(find usr/lib/python3* -name "*.pyc")
}

pyc1() {
	pkgdesc="$pkgdesc (.opt-1.pyc pycache files)"
	depends=""

	cd "$pkgdir"
	amove $(find usr/lib/python3* -name "*.opt-1.pyc")
}

pyc2() {
	pkgdesc="$pkgdesc (.opt-2.pyc pycache files)"
	depends=""

	cd "$pkgdir"
	amove $(find usr/lib/python3* -name "*.opt-2.pyc")
}

