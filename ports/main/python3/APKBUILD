prepare() {
	default_prepare

	# force system libs
	rm -r Modules/expat
}

# wasm64: stage sibling ports' headers and libraries for the cross build.
# Replaces upstream's makedepends for wasm64 library dependencies — those
# are wasm64 packages that cannot be apk-add'd into the aarch64 container.
_stage_deps() {
	local deps="$srcdir/deps-staged"
	apk add --root "$deps" --initdb --no-scripts --no-chown \
		--arch "$CARCH" --keys-dir "${VISORJS_APK_KEYS:-/work/ports/keys}" \
		--repository "$REPODEST/main" \
		openssl-dev zlib-dev zstd-dev bzip2-dev xz-dev expat-dev mpdecimal-dev \
		sqlite-dev readline-dev ncurses-dev \
		libcrypto3 libssl3 zlib zstd-libs libbz2 xz-libs libexpat mpdecimal \
		sqlite-libs readline libncursesw libpanelw \
		linux-headers \
		|| die "staging the dependency root failed"

	export PKG_CONFIG_PATH="$deps/usr/lib/pkgconfig:$deps/usr/share/pkgconfig"
	export PKG_CONFIG_LIBDIR="$deps/usr/lib/pkgconfig:$deps/usr/share/pkgconfig"
	export PKG_CONFIG_SYSROOT_DIR="$deps"
	_deps="$deps"
}

build() {
	_stage_deps

	# set thread stack size to 2MB so we don't segfault before we hit
	# sys.getrecursionlimit()
	# note: raised from 1 as we ran into some stack limit on x86_64 too
	# sometimes, but not recursion
	local stacksize=0x200000

	# we want -O2 here for more speed for such a large interpreter.
	export CFLAGS_NODIST="$CFLAGS -O2 -DTHREAD_STACK_SIZE=$stacksize -I$_deps/usr/include"
	export CXXFLAGS_NODIST="$CXXFLAGS -O2"
	# wasm64: upstream's -Wl,-z,stack-size=$stacksize is an ELF linker
	# flag with no wasm equivalent; dropped.  -L for staged deps added.
	export LDFLAGS_NODIST="$LDFLAGS -L$_deps/usr/lib"

	# wasm64: ppc64le case dropped (not applicable to this arch).

	# we set them via NODIST to not propagate them and duplicate them to modules
	unset LDFLAGS CFLAGS CXXFLAGS CPPFLAGS

	# wasm64: the staged sysroot's search paths must NOT go through
	# *_NODIST.  configure's own AC_CHECK_HEADERS / AC_CHECK_LIB probes
	# compile with $CPPFLAGS and $LDFLAGS only — *_NODIST reaches the
	# Makefile but not the probes — so a dependency staged under
	# $_deps is invisible to detection unless it is also spelled here.
	# That is why the -I/-L are set after the unset above rather than
	# before it, and why only the search paths are: the optimization and
	# hardening flags upstream is unsetting stay unset.  package() strips
	# these builder paths back out of the installed sysconfig.
	export CPPFLAGS="-I$_deps/usr/include"
	export LDFLAGS="-L$_deps/usr/lib"

	# wasm64 divergences from upstream's ./configure, each wasm64-forced:
	#   --host=$CARCH-alpine-linux-musl instead of --host=$CHOST: abuild
	#     maps no CHOST for wasm64.
	#   --with-build-python added: cross-compilation needs a native Python
	#     to run freeze_module, compileall and generator scripts — the
	#     wasm64 binary being built cannot execute in this container.
	#   --enable-optimizations dropped: PGO runs the test suite to collect
	#     profiling data; the wasm binary is unexecutable here.
	#   --with-lto dropped: LTO through the reactor wrappers is untested.
	#   ac_cv_* cache: every variable below answers a configure probe that
	#     would otherwise try to execute a compiled program.  Values are
	#     from the wasm64 musl sysroot's symbol table and the reactor
	#     platform's type model (LP64, 4-byte wchar_t, 8-byte time_t).
	#   ac_cv_func_* table: wasm-ld rejects autoconf's `char f (void);`
	#     link probes with a signature mismatch against libc.so, so every
	#     AC_CHECK_FUNCS symbol in configure.ac is answered from the
	#     wasm64 sysroot's own symbol table rather than by linking a
	#     conftest.  Same treatment as main/nano and main/readline.
	#   ac_cv_lib_sqlite3_*: same wall, but against libsqlite3.so — these
	#     answer sqlite3's AC_CHECK_LIB probes from that library's own
	#     symbol table.  Without them _sqlite3 silently drops out.
	#   ac_cv_search_initscr / ac_cv_search_update_panels: the same wall
	#     again, this time AC_SEARCH_LIBS.  Naming the library that does
	#     define the symbol is what the probe would have concluded; without
	#     them _curses and _curses_panel drop out.
	./configure \
		--build=$CBUILD \
		--host=$CARCH-alpine-linux-musl \
		--prefix=/usr \
		--enable-ipv6 \
		--enable-loadable-sqlite-extensions \
		--enable-shared \
		--with-computed-gotos \
		--with-system-expat \
		--with-system-libmpdec \
		--with-build-python=/usr/bin/python3 \
		--without-ensurepip \
		\
		ac_cv_file__dev_ptmx=no \
		ac_cv_file__dev_ptc=no \
		ac_cv_buggy_getaddrinfo=no \
		ac_cv_broken_sem_getvalue=no \
		ac_cv_wchar_t_signed=yes \
		ac_cv_working_tzset=yes \
		ac_cv_have_long_long_format=yes \
		ac_cv_have_size_t_format=yes \
		ac_cv_pthread_system_supported=yes \
		ac_cv_pthread=yes \
		ac_cv_func_chown_works=yes \
		ac_cv_func_getgroups_works=yes \
		ac_cv_search_initscr=-lncursesw \
		ac_cv_search_update_panels=-lpanelw \
		ac_cv_lib_sqlite3_sqlite3_bind_double=yes \
		ac_cv_lib_sqlite3_sqlite3_column_decltype=yes \
		ac_cv_lib_sqlite3_sqlite3_column_double=yes \
		ac_cv_lib_sqlite3_sqlite3_complete=yes \
		ac_cv_lib_sqlite3_sqlite3_progress_handler=yes \
		ac_cv_lib_sqlite3_sqlite3_result_double=yes \
		ac_cv_lib_sqlite3_sqlite3_set_authorizer=yes \
		ac_cv_lib_sqlite3_sqlite3_trace_v2=yes \
		ac_cv_lib_sqlite3_sqlite3_trace=yes \
		ac_cv_lib_sqlite3_sqlite3_value_double=yes \
		ac_cv_lib_sqlite3_sqlite3_load_extension=yes \
		ac_cv_lib_sqlite3_sqlite3_serialize=yes \
		ac_cv_func___fpu_control=no \
		ac_cv_func__getpty=no \
		ac_cv_func_accept4=yes \
		ac_cv_func_acosh=yes \
		ac_cv_func_alarm=yes \
		ac_cv_func_asinh=yes \
		ac_cv_func_atanh=yes \
		ac_cv_func_backtrace=no \
		ac_cv_func_bind_textdomain_codeset=yes \
