# Maintainer: visorjs <info@visorjs.com>
pkgname=python3

# python3-extra's pkgver needs to be synchronized with this.
pkgver=3.14.7
_basever="${pkgver%.*}"
pkgrel=8
pkgdesc="High-level scripting language"
url="https://www.python.org/"
arch="wasm64"
license="PSF-2.0"

# wasm64: -dbg dropped (wasm objects are not ELF, no split-debug step).
# -idle dropped (no Tkinter/X11 on this platform).
# pyc0 comes last because the files are named without a unique substring
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-tests::noarch
	$pkgname-pyc:_default_pyc
	$pkgname-pycache-pyc2
	$pkgname-pycache-pyc1
	$pkgname-pycache-pyc0
	pyc:_pyc_meta:noarch
	"

# https://github.com/python/cpython/issues/149018
# wasm64: runtime deps spelled out, with the musl floor tracedeps cannot
# add. Extension modules in lib-dynload/ link these shared libraries at
# import time.
depends="musl>=1.2.6-r28 libcrypto3 libssl3 zlib zstd-libs libbz2 xz-libs libexpat mpdecimal sqlite-libs readline libncursesw libpanelw"
# wasm64: upstream's makedepends are wasm64 library headers that cannot
# be apk-add'd into this aarch64 build container; they are staged from
# the local ports repo by _stage_deps() below instead.  Only host tools
# appear here.  python3 is the container's native Python, used as
# --with-build-python for cross-compilation (freeze_module, compileall,
# generator scripts — all steps that execute Python and cannot use the
# wasm64 binary being built).
# Added beyond upstream's makedepends: zstd-dev.  CPython 3.14 ships the
# _zstd module and Alpine's recipe has not picked up the dependency yet;
# this tree already has a zstd port, so the module is built rather than
# dropped.
# Upstream makedepends not staged (no port / not applicable to wasm64):
#   !gettext-dev and musl-libintl (musl's own libintl stubs are in libc),
#   bluez-headers (no Bluetooth stack), tcl-dev (no Tk/X11 on this
#   platform), libffi-dev (no port: wasm has no runtime call trampolines,
#   so _ctypes stays unbuilt).
makedepends="python3"
# wasm64: idle.desktop dropped (no idle subpackage, no Tkinter/X11).
source="https://www.python.org/ftp/python/$pkgver/Python-$pkgver.tar.xz
	externally-managed
	musl-find_library.patch
	wasm64-link-modules-against-libpython.patch
	"
# wasm64: !check (wasm binary unexecutable in build container), !strip
# (wasm objects not ELF), !archcheck — standard for every
# recipe in this tree.  Upstream's options="net" (for check()) dropped.
options="!check !strip !archcheck"
builddir="$srcdir/Python-$pkgver"

