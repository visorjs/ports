# Maintainer: visorjs <info@visorjs.com>
pkgname=libunistring
pkgver=1.4.2
pkgrel=8
pkgdesc="Library for manipulating Unicode strings and C strings"
url="https://www.gnu.org/software/libunistring/"
arch="wasm64"
license="GPL-2.0-or-later OR LGPL-3.0-or-later"
depends="musl>=1.2.6-r28"
depends_dev="$pkgname=$pkgver-r$pkgrel"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
options="!check !strip !archcheck"
source="https://ftp.gnu.org/gnu/libunistring/libunistring-$pkgver.tar.xz"

# gnulib gnulib-local/lib probes require musl/linux cache variables and
# -D__linux__ -D_GNU_SOURCE. libtool does not know how to link wasm shared
# objects, so libunistring.so.5 is linked via reactor-link directly from the
# static archive.
build() {
	export CFLAGS="$CFLAGS -D__linux__ -D_GNU_SOURCE"
	./configure \
		--build=$CBUILD \
		--host=$CARCH-alpine-linux-musl \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var \
		--enable-shared \
		--enable-static \
		--disable-nls \
		ac_cv_func___fseterr=yes \
		gl_cv_onwards_func___fseterr=yes \
		ac_cv_func_newlocale=yes \
		ac_cv_func_duplocale=yes \
		ac_cv_func_freelocale=yes
	make SUBDIRS="doc gnulib-local lib"

	$LD --entry-shape=shared --soname libunistring.so.5 \
		-Wl,--whole-archive lib/.libs/libunistring.a -Wl,--no-whole-archive \
		"$REACTOR_SYSROOT/lib/libc.so" \
		-o lib/.libs/libunistring.so.5.2.1
	ln -sf libunistring.so.5.2.1 lib/.libs/libunistring.so.5
	ln -sf libunistring.so.5.2.1 lib/.libs/libunistring.so
}

package() {
	make SUBDIRS="doc gnulib-local lib" DESTDIR="$pkgdir" install
}

sha512sums="
