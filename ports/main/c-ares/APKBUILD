# Maintainer: visorjs <info@visorjs.com>
pkgname=c-ares
pkgver=1.34.8
pkgrel=8
pkgdesc="Asynchronous DNS/names resolver library"
url="https://c-ares.org/"
arch="wasm64"
license="MIT"
depends="musl>=1.2.6-r28"
depends_dev="$pkgname=$pkgver-r$pkgrel"
subpackages="$pkgname-doc $pkgname-dev $pkgname-utils"
options="!check !strip !archcheck"
source="https://github.com/c-ares/c-ares/releases/download/v$pkgver/c-ares-$pkgver.tar.gz"

# secfixes:
#   1.34.8-r0:
#     - CVE-2026-33630
#   1.34.6-r0:
#     - CVE-2025-62408
#   1.34.5-r0:
#     - CVE-2025-31498
#   1.27.0-r0:
#     - CVE-2024-25629
#   1.17.2-r0:
#     - CVE-2021-3672

# cmake/samurai/gtest-dev are dropped: cmake+ninja are baked into the
# toolchain image already, and nothing here runs a wasm64 test binary.
build() {
	cmake -B build -G Ninja \
		-DCMAKE_TOOLCHAIN_FILE=/usr/local/share/reactor/cmake/wasm64-reactor.cmake \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
		-DCARES_SHARED=ON \
		-DCARES_STATIC=ON \
		-DCARES_STATIC_PIC=ON \
		-DCARES_BUILD_TESTS="$(want_check && echo ON || echo OFF)" \
		-DCARES_SYMBOL_HIDING=ON \
		-DCARES_THREADS=ON

	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

utils() {
	depends="c-ares musl>=1.2.6-r28"
	amove usr/bin
}

sha512sums="
