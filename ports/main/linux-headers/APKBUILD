# Maintainer: visorjs <info@visorjs.com>
pkgname=linux-headers
pkgver=7.1.5
# NOTE: Follows Greg's stable Linux releases, see kernel.org
_kernver=${pkgver%.*}
pkgrel=1
pkgdesc="Linux system headers"
url="https://kernel.org/"
arch="wasm64"
license="GPL-2.0-only"
makedepends="perl"
options="!check !strip !archcheck"
source="https://kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/linux-$_kernver.tar.xz
	revert-broken-uapi.patch
	0003-remove-inclusion-of-sysinfo.h-in-kernel.h.patch
	bitsperlong-derive-word-size-from-the-compiler.patch
	"
if [ "${pkgver%.0}" = "$pkgver" ]; then
	source="
		patch-$pkgver.patch.xz::https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/patch-$pkgver.xz
		$source
		"
fi
builddir="$srcdir/linux-$_kernver"

# This mirrors aports' main/linux-headers, which is what supplies the
# kernel UAPI headers (`linux/*`, `asm/*`, `mtd/*`, …) that musl does not
# ship and that upstream busybox declares as `makedepends_host`. musl's own
# `bits/kd.h` and `bits/vt.h` include `linux/kd.h` and `linux/vt.h`, so a
# sysroot without these is incomplete rather than this being one package's
# unusual demand.
#
# Divergences from aports, both consequences of the target not being a
# Linux architecture:
#   - `_carch` maps wasm64 to x86. The UAPI `asm/` subtree is where the
#     syscall numbers live, and this platform's are x86_64's: musl's
#     `bits/syscall.h` here defines __NR_read 0 / __NR_write 1, so
#     `asm/unistd.h` has to agree or an applet reaching for a __NR_ that
#     musl does not wrap (busybox's ionice, __NR_ioprio_get) issues a
#     different syscall than the one it names. x86's asm/unistd.h keys on
#     __i386__ and falls through to the 64-bit table, which is the one
#     that matches.
#   - One patch of our own, on top of aports' two: x86's
#     `asm/bitsperlong.h` derives the word size from __x86_64__ alone and
#     otherwise says 32, and a wasm64 compile defines neither __i386__ nor
#     __x86_64__ while being LP64. The patch drops that branch so
#     asm-generic's own __SIZEOF_LONG__ path answers instead — upstream's
#     documented modern spelling, and identical to today's answer on a
#     real x86_64 toolchain.
#
# The `arch="all"` of upstream becomes this tree's single wasm64: the
# package is architecture-specific for exactly the reason above, and this
# tree has one architecture.

_carch="$CARCH"
case "$_carch" in
wasm64*) _carch="x86" ;;
aarch64*) _carch="arm64" ;;
arm*) _carch="arm" ;;
mips*) _carch="mips" ;;
s390*) _carch="s390" ;;
ppc*) _carch="powerpc" ;;
riscv*) _carch="riscv" ;;
loongarch*) _carch="loongarch" ;;
esac

build() {
	# Upstream's `headers` target compiles only scripts/unifdef, with
	# HOSTCC — nothing here is built for the target, which is why this
	# recipe never touches $CC.
	make headers ARCH="$_carch"
}

package() {
	# This recipe's pkgdir is a Docker volume mountpoint, so abuild is run
	# with -K and never clears it (ports/build.sh, docker-compose.yml).
	rm -rf "${pkgdir:?}"/*
	mkdir -p "$pkgdir"/usr/
	cp -a usr/include/ "$pkgdir"/usr/include/

	msg "purging non header files.."
	find "$pkgdir"/usr/include/ ! -iname "*.h" -type f -exec rm -v {} \+
}
