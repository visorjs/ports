# Maintainer: visorjs <info@visorjs.com>
pkgname=tzdata
pkgver=2026c
_ptzver=0.5
pkgrel=8
pkgdesc="Timezone data"
url="https://www.iana.org/time-zones"
arch="noarch"
license="Public-Domain"
subpackages="$pkgname-right $pkgname-doc $pkgname-utils::wasm64"
options="!check !strip !archcheck"
source="https://www.iana.org/time-zones/repository/releases/tzcode$pkgver.tar.gz
	https://www.iana.org/time-zones/repository/releases/tzdata$pkgver.tar.gz
	https://dev.alpinelinux.org/archive/posixtz/posixtz-$_ptzver.tar.xz
	0001-posixtz-ensure-the-file-offset-we-pass-to-lseek-is-o.patch
	0002-fix-implicit-declaration-warnings-by-including-strin.patch
	"
builddir="$srcdir"
_timezones="africa antarctica asia australasia europe northamerica \
	southamerica etcetera backward factory"

_stage_deps() {
	local deps="$srcdir/deps-staged"
	apk add --root "$deps" --initdb --no-scripts --no-chown \
		--arch "$CARCH" --keys-dir "${VISORJS_APK_KEYS:-/work/ports/keys}" \
		--repository "$REPODEST/main" \
		musl \
		|| die "staging the dependency root failed"

	export CFLAGS="$CFLAGS -D_GNU_SOURCE -I$deps/usr/include"
	export CPPFLAGS="$CPPFLAGS -D_GNU_SOURCE -I$deps/usr/include"
	export LDFLAGS="$LDFLAGS -L$deps/usr/lib"
}

build() {
	_stage_deps

	# Build host zic to compile zoneinfo on the build machine
	make CC=gcc CFLAGS="-DHAVE_STDINT_H=1 -DHAVE_MEMPCPY=1 -DHAVE_GETTEXT=0 -DHAVE_ISSETUGID=1" \
		LDFLAGS="" TZDIR="/usr/share/zoneinfo" version.h tzdir.h zic
	cp zic zic.host
	make clean_misc

	# Build target wasm64 zic and zdump
	make CC="$CC" \
		CFLAGS="$CFLAGS -DHAVE_STDINT_H=1 -DHAVE_MEMPCPY=1 -DHAVE_GETTEXT=0 -DHAVE_ISSETUGID=1 -D_GNU_SOURCE" \
		LDFLAGS="$LDFLAGS" TZDIR="/usr/share/zoneinfo" zic zdump

	# Build target wasm64 posixtz
	make -C "$builddir"/posixtz-$_ptzver CC="$CC" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS" posixtz
}

utils() {
	pkgdesc="Timezone tools (zic, zdump, posixtz)"
	depends="musl>=1.2.6-r28"
	amove usr/bin
	amove usr/sbin
}

package() {
	mkdir -p "$pkgdir"/usr/share/zoneinfo/right
	./zic.host -b fat -d "$pkgdir"/usr/share/zoneinfo $_timezones
	./zic.host -b fat -d "$pkgdir"/usr/share/zoneinfo/right -L leapseconds $_timezones

	./zic.host -b fat -d "$pkgdir"/usr/share/zoneinfo -p America/New_York
	install -m444 -t "$pkgdir"/usr/share/zoneinfo iso3166.tab zone1970.tab zone.tab

	install -Dm755 -t "$pkgdir"/usr/sbin zic zdump

	install -Dm644 -t "$pkgdir"/usr/share/man/man8 zic.8 zdump.8

	rm -f "$pkgdir"/usr/share/zoneinfo/localtime
	install -Dm755 -t "$pkgdir"/usr/bin "$srcdir"/posixtz-$_ptzver/posixtz

	install -Dm644 -t "$pkgdir"/usr/share/zoneinfo "$srcdir"/leap-seconds.list
}

right() {
	pkgdesc="Timezone data for TAI-10 system clock"
	amove usr/share/zoneinfo/right
}

doc() {
	default_doc
	# The documentation is for the utils and not the main package
	install_if="docs $pkgname-utils=$pkgver-r$pkgrel"
}

