# Maintainer: visorjs <info@visorjs.com>
pkgname=tmux
pkgver=3.7c
pkgrel=8
pkgdesc="Tool to control multiple terminals from a single terminal"
url="https://tmux.github.io"
arch="wasm64"
license="ISC"
options="!check !strip !archcheck"
depends="musl>=1.2.6-r28 ncurses-terminfo-base libevent libncursesw"
makedepends="bison"
subpackages="$pkgname-doc"
source="https://github.com/tmux/tmux/releases/download/$pkgver/tmux-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
	default_prepare
	cp /usr/share/abuild/config.sub etc/config.sub
	cp /usr/share/abuild/config.guess etc/config.guess
}

_stage_deps() {
	local deps="$srcdir/deps-staged"
	apk add --root "$deps" --initdb --no-scripts --no-chown \
		--arch "$CARCH" --keys-dir "${VISORJS_APK_KEYS:-/work/ports/keys}" \
		--repository "$REPODEST/main" \
		musl ncurses-dev libncursesw libevent libevent-dev pkgconf linux-headers \
		|| die "staging the dependency root failed"

	export PKG_CONFIG_PATH="$deps/usr/lib/pkgconfig:$deps/usr/share/pkgconfig"
	export PKG_CONFIG_LIBDIR="$deps/usr/lib/pkgconfig:$deps/usr/share/pkgconfig"
	export CFLAGS="$CFLAGS -I$deps/usr/include -I$deps/usr/include/ncursesw"
	export CPPFLAGS="$CPPFLAGS -I$deps/usr/include -I$deps/usr/include/ncursesw"
	export LDFLAGS="$LDFLAGS -L$deps/usr/lib"
	_deps="$deps"
}

build() {
	_stage_deps

	# wasm-ld rejects autoconf's `char f (void);` function probes on
	# signature mismatch; cache variables supply the true libc / libevent / ncurses answers.
	./configure \
		--build=$CBUILD \
		--host=$CARCH-alpine-linux-musl \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--enable-sixel \
		ac_cv_search_forkpty="none required" \
		ac_cv_search_flock="none required" \
		ac_cv_search_clock_gettime="none required" \
		ac_cv_lib_m_fmod=yes \
		ac_cv_func_dirfd=yes \
		ac_cv_func_flock=yes \
		ac_cv_func_prctl=yes \
		ac_cv_func_sysconf=yes \
		ac_cv_func_tiparm=yes \
		ac_cv_func_tiparm_s=yes \
		ac_cv_func_daemon=yes \
		ac_cv_func_asprintf=yes \
		ac_cv_func_cfmakeraw=yes \
		ac_cv_func_clock_gettime=yes \
		ac_cv_func_closefrom=no \
		ac_cv_func_explicit_bzero=yes \
		ac_cv_func_fgetln=no \
		ac_cv_func_freezero=no \
		ac_cv_func_getdtablecount=no \
		ac_cv_func_getdtablesize=yes \
		ac_cv_func_getpeereid=no \
		ac_cv_func_getline=yes \
		ac_cv_func_getprogname=no \
		ac_cv_func_memmem=yes \
		ac_cv_func_setenv=yes \
		ac_cv_func_strcasestr=yes \
		ac_cv_func_strlcat=yes \
		ac_cv_func_strlcpy=yes \
		ac_cv_func_strndup=yes \
		ac_cv_func_strsep=yes \
		ac_cv_func_reallocarray=yes \
		ac_cv_func_err=yes \
		ac_cv_func_errx=yes \
		ac_cv_func_warn=yes \
		ac_cv_func_warnx=yes \
		ac_cv_header_err_h=yes
	make
}

package() {
	make DESTDIR="$pkgdir" install

	install -Dvm644 example_tmux.conf \
		"$pkgdir"/usr/share/doc/$pkgname/examples/tmux.conf
	install -Dvm644 CHANGES README \
		-t "$pkgdir"/usr/share/doc/$pkgname/
}

sha512sums="
86c4c136a844fe0ac167e6f360c555a138253867fd234ba7447342fe8f2cb660df44e51e99ca9eb9ec773851f2c04e4a64de81a43a3d1bcd42ba99c704843d79  tmux-3.7c.tar.gz
"
