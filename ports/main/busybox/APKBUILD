# Maintainer: visorjs <info@visorjs.com>
pkgname=busybox
pkgver=1.38.0
pkgrel=12
pkgdesc="Size optimized toolbox of many common UNIX utilities"
url="https://busybox.net/"
arch="wasm64"
license="GPL-2.0-only"
depends="musl>=1.2.6-r28"
# perl is upstream's makedepends_build: the documentation targets shell out
# to pod2man and silently produce nothing without it, which would leave the
# -doc subpackage empty. bash is pinned exactly: Alpine's mirror keeps only
# the current pkgrel, so an upstream bump makes this `apk add` fail with
# "unable to select packages", and the fix is to bump the pin rather than to
# unpin it.
#
# Upstream's makedepends_host — linux-headers, openssl-dev>3, utmps-dev,
# utmps-static — are host packages there and wasm64 ones here, so they are
# not in this list: linux-headers, openssl-dev, libcrypto3 and libssl3 are
# this tree's own packages, staged from the signed repo into a private root
# in prepare() the way nodejs stages its siblings. utmps has
# no package here at all, which is exactly upstream's own BOOTSTRAP path —
# see build().
makedepends="perl bash=5.3.9-r1"
install="$pkgname.post-install $pkgname.post-upgrade
	$pkgname-extras.post-install $pkgname-extras.pre-deinstall"
subpackages="
	$pkgname-static
	$pkgname-doc
	$pkgname-suid
	ssl_client
	$pkgname-ifupdown::noarch
	$pkgname-binsh::noarch
	$pkgname-extras
	"
options="!check !strip !archcheck suid"
triggers="busybox.trigger=/bin:/usr/bin:/sbin:/usr/sbin:/lib/modules/*:/usr/lib/modules/*"
source="https://busybox.net/downloads/busybox-$pkgver.tar.bz2
	0001-ash-exec-busybox.static.patch
	0002-awk-fix-handling-of-literal-backslashes-in-replaceme.patch
	0003-blkdiscard-ship-link-to-sbin-instead-of-usr-bin.patch
	0004-hexdump-fix-regression-with-n4-e-u.patch
	0005-init-add-support-for-separate-reboot-action.patch
	0006-mount-fix-parsing-proc-mounts-with-long-lines.patch
	0007-tar-fix-TOCTOU-symlink-race-condition.patch
	0008-tunctl-fix-segfault-on-ioctl-failure.patch
	0009-wget-add-header-Accept.patch
	0010-adduser-default-to-sbin-nologin-as-shell-for-system-.patch
	0011-ash-add-built-in-BB_ASH_VERSION-variable.patch
	0012-Avoid-redefined-warnings-when-buiding-with-utmps.patch
	0013-libbb-sockaddr2str-ensure-only-printable-characters-.patch
