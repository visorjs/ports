# This recipe mirrors aports' main/busybox. Every file in source= above is
# byte-identical to that recipe's copy, checksums included — all forty
# patches, both configs, and the auxiliary sources — and so are the
# install= and triggers= scripts, which create the applet links in-guest.
# Patches are carried whole rather than filtered down to the applets this
# tree exercises: staying byte-identical to aports is worth more than
# dropping hunks that cost nothing.
#
# Unlike zlib and sqlite, this recipe drives upstream's own make.
# Everything that made those refuse to is absent here:
#   - Kbuild links through $(CC), and reactor-cc is a link driver: an
#     invocation with no -c/-E/-S and at least one input is a link, handed
#     to reactor-link under an inferred entry shape. With no -shared, no
#     soname and a non-lib*.so* output that shape is `dynamic`, which is
#     the shape every end-user binary in this tree links with anyway.
#   - scripts/trylink probes by compiling and linking, never by running
#     what it built. So --sort-common, --sort-section, --warn-common, -Map
#     and --verbose drop themselves when wasm-ld rejects them, and
#     check_libc_is_glibc answers correctly from a compile alone. That is
#     the property the ports contract's configure-script rule turns on.
#   - SKIP_STRIP=y is upstream's own knob, so the ELF strip that cannot
#     read a wasm object is never invoked — the same reason every recipe
#     here sets options="!strip".
#
# Divergences from aports' build, each also commented at its line below:
#   - CC/HOSTCC are passed on the make command line. Kbuild assigns
#     `CC = $(CROSS_COMPILE)gcc` in the Makefile, and a makefile assignment
#     beats the environment, so abuild's exported CC would otherwise be
#     ignored and the container's own gcc would build wasm-bound objects.
#   - No utmps. Upstream feeds CONFIG_EXTRA_CFLAGS/CONFIG_EXTRA_LDLIBS from
#     `pkg-config --static libutmps` unless BOOTSTRAP is set; there is no
#     utmps package in this tree, so this is upstream's own BOOTSTRAP path
#     with the empty values it produces.
#   - ssl_client links this tree's libssl/libcrypto by path rather than
#     through pkg-config against the build host.

# The build host's own compiler, for Kbuild's host-side codegen (fixdep,
# the kconfig parser, applet_tables, usage_pod). The toolchain image puts
# the patched clang first on PATH; with no --target it builds for the
# container.
_cc_host="clang"

_staticdir="$srcdir"/build-static
_dyndir="$srcdir"/build-dynamic
_dyndir_extras="$srcdir"/build-dynamic-extras
_config="$srcdir"/busyboxconfig
_config_extras="$srcdir"/busyboxconfig-extras
_deps="$srcdir"/deps

# Platform additions to every target compile, passed through the config's
# own CONFIG_EXTRA_CFLAGS so they reach both the compile and the trylink
# link line:
#   -I$_deps/usr/include: the kernel UAPI headers, from this tree's
#   linux-headers package staged in prepare(). Upstream gets the same set
#   from its linux-headers makedepends_host; musl ships none of them, and
#   its own bits/kd.h and bits/vt.h include linux/kd.h and linux/vt.h.
#   -D__linux__: the wasm64 target does not define __linux__, so busybox's
#   platform.h and every applet that guards a linux/*.h include on it
#   would compile against a truncated view of the headers.
#   -mllvm -wasm-enable-sjlj / -mexception-handling: ash's error recovery
#   and every applet reached through bb_error_msg_and_die longjmp out, and
#   this platform lowers setjmp/longjmp to the wasm exception-handling tag
#   libc.so defines.
_platform_cflags="-I$_deps/usr/include -D__linux__=1 -mllvm -wasm-enable-sjlj -mexception-handling"

prepare() {
	# remove SGID if set as it confuses the busybox testsuite
	chmod -R g-s "$builddir"
	default_prepare

	mkdir -p "$_staticdir" "$_dyndir" "$_dyndir_extras"

	# A private root installed from the local signed repo, for ssl_client:
	# apk takes each version from the index, so no version is written down
	# twice. libcrypto3 and libssl3 are named beside openssl-dev because
	# that -dev package does not depend on the runtime halves carrying the
	# .so files. --no-chown is what lets this run as the builder user
	# abuild drops to, and --no-scripts because a post-install script is
	# #!/bin/sh and apk runs it chrooted into a root with no shell.
	apk add --root "$_deps" --initdb --no-scripts --no-chown \
		--arch "$CARCH" --keys-dir "${VISORJS_APK_KEYS:-/work/ports/keys}" \
		--repository "$REPODEST/main" \
		linux-headers openssl-dev libcrypto3 libssl3 \
		|| die "staging the dependency root failed"
}

# One build tree. Upstream's own comment on the duplicated command lines
# below still applies — the busybox build system breaks on any attempt to
# factorize it — but what it breaks on is factorizing the *make* calls, and
# this wrapper only factorizes the two constants every one of them passes.
_make() {
	# CONFIG_EXTRA_CFLAGS/CONFIG_EXTRA_LDLIBS are upstream's utmps hook,
	# empty here (see the header comment). CONFIG_EXTRA_CFLAGS carries this
	# platform's additions instead.
	make CC="$CC" HOSTCC="$_cc_host" SKIP_STRIP=y \
		CONFIG_EXTRA_CFLAGS="$_platform_cflags" \
		CONFIG_EXTRA_LDLIBS="\"\"" "$@"
}

build() {
	# build bbsuid
	msg "Building bbsuid"
	$CC $CPPFLAGS $CFLAGS $LDFLAGS $_platform_cflags \
		"$srcdir"/bbsuid.c -o "$_dyndir"/bbsuid

	msg "Building ssl_client"
	# Upstream resolves libcrypto/libssl with pkg-config against the build
	# host; this links the wasm64 ones this tree built, out of the staged
	# root, by path. The soname each of them was linked with is what ends
	# up in NEEDED, so naming the versioned file here is correct.
	$CC $CPPFLAGS $CFLAGS $LDFLAGS $_platform_cflags \
		-I"$_deps"/usr/include \
		"$srcdir"/ssl_client.c -o "$_dyndir"/ssl_client \
		"$_deps"/usr/lib/libssl.so.3 "$_deps"/usr/lib/libcrypto.so.3

	# build dynamic
	cd "$_dyndir"
	msg "Building dynamic busybox"
	cp "$_config" .config
	make -C "$builddir" O="$PWD" HOSTCC="$_cc_host" silentoldconfig
	_make

	# build dynamic (extras)
	cd "$_dyndir_extras"
	msg "Building dynamic busybox-extras"
	cp "$_config_extras" .config
	make -C "$builddir" O="$PWD" HOSTCC="$_cc_host" silentoldconfig
	_make

	# build static
	cd "$_staticdir"
	msg "Building static busybox"
	# enable internal ssl_client for static build
	sed -e "s/.*CONFIG_PIE.*/\# CONFIG_PIE is not set/" \
		-e "s/.*CONFIG_STATIC\([A-Z_]*\).*/CONFIG_STATIC\1=y/" \
		-e "s/.*CONFIG_SSL_CLIENT.*/CONFIG_SSL_CLIENT=y/" \
		"$_config" > .config
	make -C "$builddir" O="$PWD" HOSTCC="$_cc_host" silentoldconfig
	# reactor-cc's shape inference only ever yields `dynamic` or `shared`;
	# `process` is this toolchain's static shape (crt1.o plus libc.a by
	# path), and naming it explicitly is the only way to reach it through a
	# build system that links by calling the compiler. reactor-cc consumes
	# --entry-shape= itself rather than passing it to clang, so it is safe
	# in LDFLAGS, which trylink hands to the link line only.
	_make LDFLAGS="--entry-shape=process"
	mv busybox busybox.static
}

package() {
	install -d "$pkgdir"/usr/sbin "$pkgdir"/usr/bin "$pkgdir"/bin "$pkgdir"/sbin

	cd "$_dyndir"
	install -Dm755 busybox "$pkgdir"/bin/busybox
	install -Dm644 docs/busybox.1 "$pkgdir"/usr/share/man/man1/busybox.1
	install -Dm644 "$builddir/docs/mdev.txt" "$pkgdir"/usr/share/doc/busybox/mdev.txt

	#ifupdown needs those dirs to be present
	install -d \
		"$pkgdir"/etc/network/if-down.d \
		"$pkgdir"/etc/network/if-post-down.d \
		"$pkgdir"/etc/network/if-post-up.d \
		"$pkgdir"/etc/network/if-pre-down.d \
		"$pkgdir"/etc/network/if-pre-up.d \
		"$pkgdir"/etc/network/if-up.d
	install -Dm775 "$srcdir"/dad.if-up "$pkgdir"/etc/network/if-up.d/dad

	install -Dm644 "$srcdir"/acpid.logrotate \
		"$pkgdir/etc/logrotate.d/acpid"

	install -Dm644 "$srcdir"/udhcpc.conf "$pkgdir"/etc/udhcpc/udhcpc.conf
	install -Dm644 "$srcdir"/securetty "$pkgdir"/etc/securetty

	# script for udhcpc
	install -Dm755 "$srcdir"/default.script \
		"$pkgdir"/usr/share/udhcpc/default.script

	# Upstream installs this list from `busybox --list-path`, guarded on a
	# native build because that runs the binary. busybox.links is the same
	# list from the same source, produced by the host preprocessor, so it
	# needs no such guard. A root assembled without running scripts gets
	# its applet links from this list (ports/README.md).
	_make busybox.links
	sed 's:^:/:' busybox.links | sed 's://*:/:g' \
		| install -Dm644 /dev/stdin "$pkgdir"/etc/busybox-paths.d/busybox
}

extras() {
	pkgdesc="Additional binaries of Busybox"
	depends="$pkgname=$pkgver-r$pkgrel musl>=1.2.6-r28"
	install -Dm755 "$_dyndir_extras"/busybox "$subpkgdir"/bin/busybox-extras

	# busybox.links is a dependency of the `install` target, not of `all`,
	# and this tree is only ever built — so ask for it by name. Without
	# this the file below is silently empty: sed's failure is invisible
	# through a pipeline whose exit status is install's.
	( cd "$_dyndir_extras" && _make busybox.links )

	# Same substitution as the main package: the path list comes from
	# busybox.links rather than from running the binary.
	sed 's:^:/:' "$_dyndir_extras"/busybox.links | sed 's://*:/:g' \
		| install -Dm644 /dev/stdin \
			"$subpkgdir"/etc/busybox-paths.d/busybox-extras

	# Configuration file and lease directory used by udhcpd which
	# is part of busybox-extras, hence the files are installed here.
	install -d "$subpkgdir"/var/lib/udhcpd
	install -Dm644 "$builddir"/examples/udhcp/udhcpd.conf \
		"$subpkgdir"/etc/udhcpd.conf
}

suid() {
	pkgdesc="suid binaries of Busybox"
	depends="$pkgname=$pkgver-r$pkgrel musl>=1.2.6-r28"

	cd "$_dyndir"
	install -Dm4111 bbsuid "$subpkgdir"/bin/bbsuid
}

static() {
	pkgdesc="Statically linked Busybox"

	install -Dm755 "$_staticdir"/busybox.static \
		"$subpkgdir"/bin/busybox.static
}

ssl_client() {
	pkgdesc="External ssl_client for busybox wget"
	# Upstream reads the major from `pkg-config --modversion libssl` on the
	# build host. Here the provider is this tree's own libssl3, whose ABI
	# digit is in its package name, so the name is written out.
	install_if="$pkgname=$pkgver-r$pkgrel libssl3"

	install -Dm755 "$_dyndir"/ssl_client \
		"$subpkgdir"/usr/bin/ssl_client
}

ifupdown() {
	pkgdesc="placeholder package for busybox ifupdown"
	provides="ifupdown-any"
	provider_priority=200
	mkdir -p "$subpkgdir"
}

binsh() {
	pkgdesc="busybox ash /bin/sh"
	provides="/bin/sh"
	provider_priority=100

	install -d "$subpkgdir"/bin

	ln -s /bin/busybox "$subpkgdir"/bin/sh
}

# Dropped from aports, each for a reason this tree can name:
#   - busybox-openrc, busybox-mdev-openrc, busybox-extras-openrc, and with
#     them every *.initd/*.confd source and the acpid-poweroff.sh they
#     install: all three are pure depends="openrc>=0.24.1-r6" payloads and
#     there is no openrc package here, and a dependency is not invented
#     against a nonexistent package.
#   - replaces="busybox-initscripts", which tracks a move of
#     default.script between two Alpine packages neither of which exists
#     here.
#   - options="net", which upstream carries only so check() can use the
#     network; check() is off tree-wide.
#   - check() itself, per options="!check": it runs the binaries it built,
#     and this build host has no wasm64 loader.
