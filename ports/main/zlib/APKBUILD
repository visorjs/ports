# Maintainer: visorjs <info@visorjs.com>
pkgname=zlib
pkgver=1.3.2
_sover=1
pkgrel=8
pkgdesc="A compression/decompression Library"
url="https://zlib.net/"
arch="wasm64"
license="Zlib"
depends="musl>=1.2.6-r28"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
options="!check !strip !archcheck"
source="https://zlib.net/fossils/zlib-$pkgver.tar.gz"
builddir="$srcdir/zlib-$pkgver"

# Compiled directly rather than through upstream's ./configure, which
# composes and runs its own compile and link command lines and cannot be
# pointed at reactor-cc / reactor-link's entry shapes. Alpine's only
# configure switch beyond --shared is --disable-crcvx, which turns off a
# CRC implementation built on ARMv8 or POWER vector instructions; the
# wasm target never selects one.
build() {
	# gz*.c call lseek() without pulling in unistd.h (the upstream tree
	# expects a configure-generated Makefile to have already established
	# a POSIX environment); force it in directly rather than patch source.
	for f in *.c; do
		$CC -O2 -I. -include unistd.h -c "$f" -o "${f%.c}.o"
	done
	$LD --entry-shape=shared --soname libz.so.$_sover ./*.o \
		"$REACTOR_SYSROOT/lib/libc.so" -o libz.so
	llvm-ar rcs libz.a ./*.o
	# upstream's configure generates zlib.pc from zlib.pc.in.
	sed -e 's|@prefix@|/usr|' \
		-e 's|@exec_prefix@|${prefix}|' \
		-e 's|@libdir@|/usr/lib|' \
		-e 's|@sharedlibdir@|/usr/lib|' \
		-e 's|@includedir@|/usr/include|' \
		-e "s|@VERSION@|$pkgver|" \
		zlib.pc.in > zlib.pc
}

package() {
	# upstream's `make install` under --prefix=/usr --shared lays down the
	# versioned real file plus the two symlinks; reproduced by hand because
	# build() cannot run upstream's generated Makefile.
	install -D -m755 libz.so "$pkgdir/usr/lib/libz.so.$pkgver"
	ln -s libz.so.$pkgver "$pkgdir/usr/lib/libz.so.$_sover"
	ln -s libz.so.$pkgver "$pkgdir/usr/lib/libz.so"
	install -D -m644 libz.a "$pkgdir/usr/lib/libz.a"
	# Headers ride along so a dependent recipe compiles against the
	# same zlib it links; abuild's default dev() splits usr/include
	# out into zlib-dev.
	install -D -m644 zlib.h "$pkgdir/usr/include/zlib.h"
	install -D -m644 zconf.h "$pkgdir/usr/include/zconf.h"
	install -D -m644 zlib.pc "$pkgdir/usr/lib/pkgconfig/zlib.pc"
	install -D -m644 zlib.3 "$pkgdir/usr/share/man/man3/zlib.3"
}

sha512sums="70963771ea5d763614278a69b474f09b7d237ef8f53b675a10fe31d9923aeef601504b35d7ebd1b1e7f347e9ebb048e6b3b47fffdf137e7bdc7e8d5eb4ec4692  zlib-1.3.2.tar.gz"
