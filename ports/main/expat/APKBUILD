# Maintainer: visorjs <info@visorjs.com>
pkgname=expat
pkgver=2.8.2
_tagver=R_${pkgver//./_}
pkgrel=8
pkgdesc="XML Parser library written in C"
url="https://libexpat.github.io/"
arch="wasm64"
license="MIT"
# aports has checkdepends="bash" for its check(); options="!check" is
# tree-wide here (the aarch64 build container cannot execute a wasm64
# binary), so the test dependency has nothing to serve and is dropped.
# aports relies on tracedeps to attribute libexpat.so.1 to a package;
# xmlwf's runtime libraries are spelled out here as well, with the musl
# floor tracedeps cannot add.
depends="musl>=1.2.6-r28 libexpat"
options="!check !strip !archcheck"
source="https://github.com/libexpat/libexpat/releases/download/$_tagver/expat-$pkgver.tar.xz"
# pull in xmlwf for dev
depends_dev="$pkgname=$pkgver-r$pkgrel"
# Order matters, ensure -dev does not gobble up static libraries.
subpackages="$pkgname-static $pkgname-dev $pkgname-doc lib$pkgname:libs"

