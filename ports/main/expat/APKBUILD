# lib/Makefile.am links with -version-info LIBCURRENT:LIBREVISION:LIBAGE,
# which configure.ac sets to 13:2:12. libtool's spelling of that is soname
# libexpat.so.(13-12) with real file libexpat.so.(13-12).12.2, and
# reactor-link stamps the same soname below.
_sover=1
_solib="libexpat.so.$_sover.12.2"

build() {
	# aports passes --host=$CHOST; abuild has no wasm64 entry in its
	# arch-to-host-spec table, so the triple is spelled out, as every
	# recipe in this tree does.
	#
	# --disable-shared is a wasm64 divergence. libtool decides at
	# configure time how to produce a shared object by probing $LD,
	# which here is reactor-link — not a GNU ld and not a platform
	# libtool has a case for; libunistring's recipe hit the same wall.
	# So libtool builds only the archive and the shared object is
	# linked from it by reactor-link below, which is what stamps the
	# soname.
	#
	# --without-tests is a wasm64 divergence: the test programs exist
	# only to be run by check(), which options="!check" turns off
	# tree-wide, and enabling them additionally makes
	# AX_CXX_COMPILE_STDCXX_11 mandatory for a C++ toolchain nothing
	# installed would use.
	#
	# ac_cv_func_mmap_fixed_mapped answers AC_FUNC_MMAP, which decides
	# by *running* an mmap program and so cannot run here. Answered no
	# — also autoconf's own cross-compilation default — which selects
	# xmlwf's readfilemap.c over unixfilemap.c.
	#
	# No other cache variables are needed. Expat's remaining link
	# probes (arc4random, arc4random_buf, getentropy, getrandom,
	# syscall SYS_getrandom) are AC_LINK_IFELSE bodies with the real
	# prototypes from <stdlib.h>/<unistd.h>/<sys/random.h> rather than
	# autoconf's `char f (void);` shape, so wasm-ld has no signature
	# mismatch to reject, and all five symbols are defined in this
	# platform's libc — the probes answer correctly on their own.
	./configure \
		--build=$CBUILD \
		--host=$CARCH-alpine-linux-musl \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--enable-static \
		--disable-shared \
		--without-tests \
		ac_cv_func_mmap_fixed_mapped=no
	make

	$LD --entry-shape=shared --soname "libexpat.so.$_sover" \
		-Wl,--whole-archive lib/.libs/libexpat.a -Wl,--no-whole-archive \
		"$REACTOR_SYSROOT/lib/libc.so" \
		-o "lib/.libs/$_solib"
	ln -sf "$_solib" "lib/.libs/libexpat.so.$_sover"
	ln -sf "$_solib" lib/.libs/libexpat.so

	# make linked xmlwf against the archive, the only library libtool
	# was allowed to build. Relink it against the shared object so the
	# installed program matches aports', which carries no copy of the
	# parser of its own.
	$CC xmlwf/xmlwf-*.o \
		"lib/.libs/$_solib" \
		"$REACTOR_SYSROOT/lib/libc.so" \
		-o xmlwf/xmlwf
}

package() {
	make DESTDIR="$pkgdir/" install

	# make install knows only about the archive (see build()); lay down
	# the shared object and the two symlinks libtool's install would
	# have produced, at aports' paths.
	install -D -m755 "lib/.libs/$_solib" "$pkgdir/usr/lib/$_solib"
	ln -s "$_solib" "$pkgdir/usr/lib/libexpat.so.$_sover"
	ln -s "$_solib" "$pkgdir/usr/lib/libexpat.so"
}

libs() {
	pkgdesc="$pkgdesc (libraries)"
	depends="musl>=1.2.6-r28"

	amove usr/lib/libexpat.so.*
}

