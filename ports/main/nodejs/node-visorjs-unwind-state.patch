 #include "v8-profiler.h"
 #include "v8-sandbox.h"  // v8::Object::Wrap(), v8::Object::Unwrap()
+#include "visorjs-unwind.h"
 
 #include <algorithm>
 #include <atomic>
@@ -194,6 +195,21 @@
