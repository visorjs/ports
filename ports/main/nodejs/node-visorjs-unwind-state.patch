 }
 
+void AsyncHooks::VisorjsUnwindStack(uint32_t length) {
+  while (fields_[kStackLength] > length) {
+    uint32_t offset = fields_[kStackLength] - 1;
+    async_id_fields_[kExecutionAsyncId] = async_ids_stack_[2 * offset];
+    async_id_fields_[kTriggerAsyncId] = async_ids_stack_[2 * offset + 1];
+    fields_[kStackLength] = offset;
+  }
+  // The JavaScript side's resources are its own frames' to pop: those
+  // unwind as JavaScript does, through their finally blocks. Nothing here
+  // calls the engine, so this runs with whatever stack is left.
+  if (native_execution_async_resources_.size() > length) {
+    native_execution_async_resources_.resize(length);
+  }
+}
+
 void AsyncHooks::clear_async_id_stack() {
   if (!js_execution_async_resources_.IsEmpty() && env()->can_call_into_js()) {
     Isolate* isolate = env()->isolate();
@@ -987,9 +1003,40 @@
     performance_state_->Mark(performance::NODE_PERFORMANCE_MILESTONE_V8_START,
                             performance::performance_v8_start);
   }
+
+  // A frame the host's stack overflow drops runs no destructor: the shim
+  // marks these counts at each entry into the guest and puts them back
+  // when one is unwound.
+  visorjs::AddUnwindState(
+      isolate(),
+      [](void* env) {
+        return static_cast<Environment*>(env)->VisorjsUnwindMark();
+      },
+      [](void* env, uint64_t mark) {
+        static_cast<Environment*>(env)->VisorjsUnwindRestore(mark);
+      },
+      this);
 }
 
+// The three counts, packed: the async id stack's length in the low word,
+// then 16 bits each for the callback scope depth and the should-not-abort
+// scopes.
+uint64_t Environment::VisorjsUnwindMark() {
+  const uint32_t stack = async_hooks_.fields()[AsyncHooks::kStackLength];
+  return static_cast<uint64_t>(stack) |
+         (static_cast<uint64_t>(async_callback_scope_depth_ & 0xffff) << 32) |
+         (static_cast<uint64_t>(should_not_abort_scope_counter_ & 0xffff)
+          << 48);
+}
+
+void Environment::VisorjsUnwindRestore(uint64_t mark) {
+  async_callback_scope_depth_ = static_cast<size_t>((mark >> 32) & 0xffff);
+  should_not_abort_scope_counter_ = static_cast<int>((mark >> 48) & 0xffff);
+  async_hooks_.VisorjsUnwindStack(static_cast<uint32_t>(mark));
+}
+
 Environment::~Environment() {
+  visorjs::RemoveUnwindState(isolate(), this);
   HandleScope handle_scope(isolate());
   Local<Context> ctx = context();
 
