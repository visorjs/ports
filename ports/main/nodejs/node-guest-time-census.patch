Guest-time census brackets on node's own fs request path.

Each pair is one bucket in the shim's per-thread exclusive-time accumulator
(packages/v8-shim/csrc/apistats.{h,cc}); src/reactor_census.h declares the
seam once and carries the RAII span, so every return path out of a bracketed
region closes its bucket. The hooks are empty inlines off the wasm64 target,
and inside the shim the disarmed test is one plain bool load.

AsyncWrap's 4-arg constructor delegates unconditionally to its 2-arg one, so
only the 2-arg one opens async_wrap_ctor: the bucket counts once per
constructed object rather than twice with the outer span nesting the inner.

There is no fs_req_callback_ctor bucket. FSReqCallback's constructor body is
empty -- all of its work is in the mem-initializer list, which runs before a
span opened in the body could start -- and the FSReqBase constructor it
delegates to has an empty body too, so there is nothing a bracket at either
site could measure.

--- a/src/reactor_census.h	1969-12-31 17:00:00
+++ b/src/reactor_census.h
@@ -0,0 +1,95 @@
+#ifndef SRC_REACTOR_CENSUS_H_
+#define SRC_REACTOR_CENSUS_H_
+
+// Guest-time census hooks. Each pair opens and closes one bucket in the
+// shim's per-thread exclusive-time accumulator (packages/v8-shim/csrc/
+// apistats.{h,cc}), so a span's self time is node's own C++ inside it and
+// never a nested span or the JS below it.
+//
+// The definitions live in libv8_spidermonkey.a, which only the wasm64
+// target links; the host toolset has no shim, so there they are empty
+// inline functions the compiler deletes outright. Armed only when
+// REACTOR_V8_API_TIME or REACTOR_V8_API_STATS is set in the environment;
+// the disarmed test inside the shim is one plain bool load.
+
+#define REACTOR_CENSUS_HOOK_LIST(X)                                            \
+  X(make_callback)                                                             \
+  X(callback_scope_close)                                                      \
+  X(fs_after)                                                                  \
+  X(async_wrap_ctor)                                                           \
+  X(async_reset)                                                               \
+  X(emit_async_init)                                                           \
+  X(base_object_ctor)                                                          \
+  X(make_weak)                                                                 \
+  X(buffer_value)                                                              \
+  X(fs_req_init)                                                               \
+  X(dispatch)                                                                  \
+  X(env_current)                                                               \
+  X(fs_lstat)                                                                  \
+  X(fs_mkdir)                                                                  \
+  X(fs_open)                                                                   \
+  X(fs_close)                                                                  \
+  X(fs_write_buffer)
+
+#if defined(__wasm__)
+extern "C" {
+#define REACTOR_CENSUS_DECLARE(name)                                           \
+  void reactor_node_##name##_begin(void);                                      \
+  void reactor_node_##name##_end(void);
+REACTOR_CENSUS_HOOK_LIST(REACTOR_CENSUS_DECLARE)
+#undef REACTOR_CENSUS_DECLARE
+}
+#else
+#define REACTOR_CENSUS_DECLARE(name)                                           \
+  inline void reactor_node_##name##_begin(void) {}                             \
+  inline void reactor_node_##name##_end(void) {}
+REACTOR_CENSUS_HOOK_LIST(REACTOR_CENSUS_DECLARE)
+#undef REACTOR_CENSUS_DECLARE
+#endif
+
+// Both expansions are done; the list has no consumer outside this header,
+// and leaving the name defined leaks it into every translation unit that
+// includes node's headers.
+#undef REACTOR_CENSUS_HOOK_LIST
+
+namespace node {
+
+// A span that can be closed early and reopened, so a region with early
+// returns stays balanced and a nested JS call can be left outside it.
+class ReactorCensusSpan {
+ public:
+  ReactorCensusSpan(void (*begin)(), void (*end)())
+      : begin_(begin), end_(end) {
+    begin_();
+  }
+  ~ReactorCensusSpan() { Close(); }
+  void Close() {
+    if (open_) {
+      open_ = false;
+      end_();
+    }
+  }
+  void Reopen() {
+    if (!open_) {
+      open_ = true;
+      begin_();
+    }
+  }
+  ReactorCensusSpan(const ReactorCensusSpan&) = delete;
+  ReactorCensusSpan& operator=(const ReactorCensusSpan&) = delete;
+
+ private:
+  void (*begin_)();
+  void (*end_)();
+  bool open_ = true;
+};
+
+}  // namespace node
+
+// Opens `name`'s bucket for the rest of the enclosing scope. RAII, so every
+// return path -- including a throw -- closes it.
+#define REACTOR_CENSUS_SPAN(var, name)                                         \
+  ::node::ReactorCensusSpan var(&reactor_node_##name##_begin,                  \
+                                &reactor_node_##name##_end)
+
+#endif  // SRC_REACTOR_CENSUS_H_
