+static int uv__fs_inlineable(const uv_fs_t* req) {
+  switch (req->fs_type) {
+    case UV_FS_CLOSE:
+    case UV_FS_FDATASYNC:
+    case UV_FS_FSTAT:
+    case UV_FS_FSYNC:
+    case UV_FS_FTRUNCATE:
+    case UV_FS_LINK:
+    case UV_FS_LSTAT:
+    case UV_FS_MKDIR:
+    case UV_FS_RENAME:
+    case UV_FS_STAT:
+    case UV_FS_SYMLINK:
+    case UV_FS_UNLINK:
+      return 1;
+    case UV_FS_OPEN:
+      return !uv__fs_open_may_block(req);
+    case UV_FS_READ:
+    case UV_FS_WRITE:
+      /* Only for an fd uv_fs_open() reported as a regular file. Anything
+       * else -- a pipe, a socket, a tty, an fd opened outside libuv -- can
+       * block the loop thread indefinitely and stays on the pool. */
+      return uv__fs_fd_is_regular(req->file);
+    default:  /* Squelch -Wswitch warnings. */
+      break;
+  }
+
+  return 0;
+}
