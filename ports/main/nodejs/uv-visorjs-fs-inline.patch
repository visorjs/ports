+/* One fstat per open, on whichever thread ran it, and none per read or write:
+ * this is the whole cost of knowing an fd is a regular file. The byte is
+ * written unconditionally, so a successful open of a pipe, a socket or a tty
+ * -- or an fstat that fails -- stores 0 over whatever the previous owner of
+ * that fd number left there. It is therefore authoritative at every open
+ * rather than only set on regular files, which is what makes a recycled fd
+ * safe.
+ *
+ * errno is saved and restored because uv__fs_work() has already carried the
+ * result into req->result and a caller may read errno after the submitting
+ * call returns. */
+static void uv__fs_open_register(uv_fs_t* req) {
+  struct stat st;
+  int saved_errno;
+
+  if (req->fs_type != UV_FS_OPEN || req->result < 0)
+    return;
+
+  saved_errno = errno;
+  uv__fs_fd_set_regular((uv_file) req->result,
+                        fstat((int) req->result, &st) == 0 &&
+                            S_ISREG(st.st_mode));
+  errno = saved_errno;
