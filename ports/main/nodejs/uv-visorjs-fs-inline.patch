+ * anything else stays on the pool. One stat per open. A path replaced by a
+ * FIFO between that stat and the open still blocks. */
+static int uv__fs_open_may_block(const uv_fs_t* req) {
+  struct stat st;
+  int saved_errno;
+  int r;
+
+  if (req->flags & O_NONBLOCK)
+    return 0;
+
+  saved_errno = errno;
+  r = stat(req->path, &st) == 0 &&
+      !S_ISREG(st.st_mode) && !S_ISDIR(st.st_mode);
+  errno = saved_errno;
+  return r;
