+static void uv__fs_fd_set_regular(uv_file file, int on) {
+  if (file < 0 || (unsigned int) file >= UV__FS_REGULAR_FD_MAX)
+    return;  /* Out of the table's range is "not regular": stay on the pool. */
+
+  atomic_store_explicit(&uv__fs_regular_fd[file],
+                        (unsigned char) (on ? 1 : 0),
+                        memory_order_relaxed);
