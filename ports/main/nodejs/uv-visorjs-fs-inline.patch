+static int uv__fs_fd_is_regular(uv_file file) {
+  if (file < 0 || (unsigned int) file >= UV__FS_REGULAR_FD_MAX)
+    return 0;
+
+  return atomic_load_explicit(&uv__fs_regular_fd[file],
+                              memory_order_relaxed) != 0;
