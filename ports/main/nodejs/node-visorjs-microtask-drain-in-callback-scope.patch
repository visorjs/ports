+}
+
+// Asked after the microtask drain, never before it: a microtask can enqueue
+// a tick, which is why the test could not move ahead of the drain. True while
+// another pass is owed; on the last one it clears the two flags the loop used
+// to clear on its way out.
+function processTicksAgain() {
+  if (!queue.isEmpty() ||
+      (hasRejectionToWarn() && processPromiseRejections())) {
+    return true;
+  }
