-  if (tick_callback->Call(context, process, 0, nullptr).IsEmpty()) {
-    failed_ = true;
+  // The tick loop, moved down one frame out of processTicksAndRejections:
+  // one pass over the tick queue, then the microtask drain, then the test for
+  // another pass, exactly the sequence the JS loop ran -- no check between
+  // the pass and the drain, because the JS loop had none and one there would
+  // leave both tick flags set when a pass sets stopping. What changes is
+  // where the drain happens: here there is no JS frame on the stack, which
+  // is what makes the checkpoint a site the host-turn yield may unwind from.
+  // A termination reaches the loop the way it reached the JS one, as an
+  // empty return from a Call.
+  for (;;) {
+    if (tick_callback->Call(context, process, 0, nullptr).IsEmpty()) {
+      failed_ = true;
+      break;
+    }
+    context->GetMicrotaskQueue()->PerformCheckpoint(isolate);
+    Local<Value> again;
+    if (!tick_again->Call(context, process, 0, nullptr).ToLocal(&again)) {
+      failed_ = true;
+      break;
+    }
+    if (!again->IsTrue()) break;
   }
   perform_stopping_check();
 }
