 static void SetTickCallback(const FunctionCallbackInfo<Value>& args) {
   Environment* env = Environment::GetCurrent(args);
   CHECK(args[0]->IsFunction());
+  // The second half of the tick loop, which InternalCallbackScope::Close now
+  // drives: one pass, then the microtask drain, then this. Registered in the
+  // same call so the two can never be set apart.
+  CHECK(args[1]->IsFunction());
