# The V8 API this build compiles and links against is the shim in
# packages/v8-shim, staged below out of the local repo as v8-shim-dev /
# v8-shim-static. It stands where aports' static V8 stands and exists in no
# tarball; deps/v8/include is replaced with its headers in build().

prepare() {
	default_prepare

	# Remove bundled dependencies that we're not using.
	#
	# NOTE: nghttp3 and ngtcp2 are only used when building with OpenSSL
	#  that supports QUIC. After the QUIC support is added to openssl, add
	#  options --shared-nghttp3 and --shared-ngtcp2.
	#
	# NOTE: All bundled dependencies are described in
	#  doc/contributing/maintaining/maintaining-dependencies.md.
	rm -rf deps/ada \
		deps/brotli \
		deps/cares \
		deps/corepack \
		deps/nghttp2 \
		deps/nghttp3 \
		deps/ngtcp2 \
		deps/openssl \
		deps/simdjson \
		deps/simdutf \
		deps/sqlite \
		deps/v8/third_party/jinja2 \
		deps/zlib \
		deps/zstd \
		tools/inspector_protocol/jinja2
}

# aports gets its wasm64 headers and libraries from apk, and so does this:
# a private root installed from the local signed repo, so the versions are
# the index's rather than a second copy in this file.
# --no-scripts: a post-install script is #!/bin/sh, and apk runs it chrooted
# into a root that has no shell.
#
# Divergence from aports: the -static subpackages are staged and every
# lib*.so* is then pruned, so each -l on the link line resolves to the
# archive and node ends up mostly statically linked. aports links these
# shared to share one copy across a system's binaries; here the only
# consumer is node itself, and a shared object costs an instantiation, a
# relocation pass and a NEEDED resolve on every single exec. The price is
# aports' upgrade story: a CVE bump in one of these libraries means
# rebuilding node too, which is the same pipeline that builds it anyway.
_stage_deps() {
	local deps="$srcdir/deps-staged"
	local fresh=0
	[ -d "$deps" ] || fresh=1
	apk add --root "$deps" --initdb --no-scripts --no-chown \
		--arch "$CARCH" --keys-dir "${VISORJS_APK_KEYS:-/work/ports/keys}" \
		--repository "$REPODEST/main" \
		openssl-dev zlib-dev zstd-dev brotli-dev c-ares-dev nghttp2-dev \
		ada-dev simdjson-dev simdutf-dev icu-dev sqlite-dev v8-shim-dev \
		openssl-libs-static zlib-static zstd-static brotli-static \
		nghttp2-static ada-static simdjson-static simdutf-static \
		icu-static sqlite-static v8-shim-static \
		|| die "staging the dependency root failed"
	# c-ares ships no -static: its libcares.a rides in c-ares-dev, as in
	# aports, so it is already staged by the -dev above.
	test -f "$deps/usr/lib/libcares.a" || die "no staged libcares.a"
	# An apk carries its build's fixed mtimes, older than any object an
	# incremental build already compiled: a freshly staged header must read
	# as new, or a changed one (the shim's v8.h) recompiles nothing.
	[ "$fresh" -eq 0 ] || find "$deps/usr/include" -type f -exec touch {} +
	# No SpiderMonkey is staged: the shim is built without it, and its
	# include/v8.h is self-contained. The Linux uapi headers below are
	# arch-neutral enough to borrow from the container.
	cp -r /usr/include/linux /usr/include/asm /usr/include/asm-generic "$deps"/usr/include/ 2>/dev/null || true
	# The prune is what makes -lfoo pick libfoo.a: wasm-ld, like ld,
	# prefers libfoo.so in the same -L directory. Runtime .so files arrive
	# here as -dev dependencies, so removing them by hand is the only way
	# to keep them off the link line.
	rm -f "$deps"/usr/lib/lib*.so "$deps"/usr/lib/lib*.so.*
	# aports reads this from icu-config, which the sibling icu-dev does not
	# ship; the staged data directory is the same answer. `die` only names
	# the failure; abuild's own `#!/bin/ash -e` already aborts on it.
	local d
	d=$(ls -d "$deps"/usr/share/icu/[0-9]*) || die "no staged icu data dir"
	# Two staged icu versions would make ${d##*/} a two-line garbage value.
	[ "$(echo "$d" | wc -l)" -eq 1 ] || die "several staged icu data dirs"
	_icu_data_dir="/usr/share/icu/${d##*/}"
}

build() {
	_stage_deps
	rm -rf "$builddir"/deps/v8/include
	mkdir -p "$builddir"/deps/v8/include
	cp -r "$srcdir"/deps-staged/usr/include/* "$builddir"/deps/v8/include/ 2>/dev/null || true

	# Add defines recommended in libuv readme.
	local common_flags="-D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64"
	# Disable use of OpenSSL ENGINE API - it's deprecated since OpenSSL 3.0
	#   (https://issues.redhat.com/browse/RHEL-33743).
	common_flags="$common_flags -DOPENSSL_NO_ENGINE"

	# -D__i386__=1 is v8config.h's only reachable host-arch answer: its host
	# block has no #if !V8_HOST_ARCH_* escape, so -DV8_HOST_ARCH_X64 is
	# ignored and its #error fires anyway. -DV8_ENABLE_CHECKS routes the
	# inline Is*() predicates to the shim's out-of-line symbols.
	# -UV8_INTL_SUPPORT is V8's flag, not node's: node's i18n comes from
	# --with-intl=system-icu below.
	common_flags="$common_flags -D__i386__=1 -DV8_ENABLE_CHECKS=1 -D__wasm32__"
	common_flags="$common_flags -UV8_COMPRESS_POINTERS -UV8_INTL_SUPPORT"
	common_flags="$common_flags -UV8_31BIT_SMIS_ON_64BIT_ARCH -D__UCLIBC__"
	# gyp picks deps/uv's linux sources from OS=="linux" and uv.h picks its
	# loop layout from __linux__; without this the two disagree.
	common_flags="$common_flags -D__linux__"
	common_flags="$common_flags -I$srcdir/deps-staged/usr/include"
	# Node makes several gyp warnings fatal, none of them written against
	# this target. It silences abuild.conf's -Werror=format-security too.
	common_flags="$common_flags -Wno-everything"

	# -Os overwrites the optimizations enabled by BUILDTYPE=Release.
	export CFLAGS="${CFLAGS/-Os} $common_flags"
	export CXXFLAGS="${CXXFLAGS/-Os} $common_flags"
	export CPPFLAGS="${CPPFLAGS/-Os} $common_flags"
	# gyp composes the link line, so the entry shape and the device
	# declaration reach the wrapper through LDFLAGS — target toolset only.
	export LDFLAGS="$LDFLAGS --entry-shape=dynamic"
	# The v8 shim imports js_v8_negotiate, so the class has to be declared
	# or the loader refuses this binary. It stays OPTIONAL: negotiate
	# answers -1 on a boot serving no v8 device, and the shim then reports
	# the missing device in one line and exits 1. ABI 2 is what the host
	# backend's descriptor serves; the loader compares the two for exact
	# equality.
	export LDFLAGS="$LDFLAGS --requires-device-optional=v8=2"
	# The executable is linked against by nothing, and --export-all names
	# every defined symbol: of node's exports, a few percent are
	# referenceable by anything in the process. Every one of them costs an
	# exports-object property per instance, a table slot per exported
	# function and an iteration in each whole-namespace pass, six times per
	# exec. The wrapper keeps the runtime's own names and both halves of
	# the weak/data seams; the families below are what only this binary
	# knows, and dropping any of them breaks silently and late.
	#
	# shim_ is the v8 device's guest-side callback surface, which the host
	# resolves by string through invokeExport.
	#
	# The rest is the native-addon ABI. An addon is dlopen'd, so no link
	# line records what it binds to; the families were derived by
	# compiling the 117 addon fixtures under test/addons,
	# test/js-native-api and test/node-api, taking the union of their
	# undefined symbols, and subtracting everything a sibling .so already
	# provides (the C++ runtime's __cxa_* come from libc++abi.so, malloc
	# and friends from libc). What is left is 226 names in four families:
	# napi_ and node_api_ (node-api), uv_ (libuv is static inside node,
	# there is no libuv.so to resolve against), node_module_register, and
	# the C++ API an addon compiled against node.h and v8.h calls into —
	# the node:: and v8:: namespaces, which mangle as _ZN4node/_ZNK4node
	# and _ZN2v8/_ZNK2v8.
	LDFLAGS="$LDFLAGS --export-set=minimal --export-prefix=shim_"
	LDFLAGS="$LDFLAGS --export-prefix=napi_ --export-prefix=node_api_"
	LDFLAGS="$LDFLAGS --export-prefix=uv_ --export-extra=node_module_register"
	LDFLAGS="$LDFLAGS --export-prefix=_ZN2v8 --export-prefix=_ZNK2v8"
	# node:: is not a prefix keep. `--export-prefix=_ZN4node` would hold
	# 6,411 exports — node's entire internal namespace, node::crypto:: alone
	# being 1,306 — to protect a published surface of 340. The addon ABI is
	# what the public headers declare (NODE_EXTERN is
	# __attribute__((visibility("default")))), so the keep is entity-scoped:
	# each name below is a class, namespace member or free function declared
	# in node.h, node_buffer.h, node_object_wrap.h or node_api.h, and Itanium
	# mangling makes `_ZN4node<len><name>` an exact prefix for all of its
	# symbols. Re-derive after a version bump by demangling the binary's
	# node:: exports and keeping those whose first component after `node::`
	# is a class, namespace or function one of those four headers declares.
	local _e _m _p
	for _e in AddEnvironmentCleanupHook AddEnvironmentCleanupHookInternal \
		AddLinkedBinding AllocateEnvironmentThreadId \
		AllowWasmCodeGenerationCallback ArrayBufferAllocator \
		AsyncHooksGetExecutionAsyncId AsyncHooksGetTriggerAsyncId \
		AsyncResource AtExit Buffer CallbackScope CommonEnvironmentSetup \
		CreateArrayBufferAllocator CreateEnvironment CreateIsolateData \
		CreatePlatform DecodeBytes DecodeWrite DefaultProcessExitHandler \
		DeleteACHHandle EmbedderSnapshotData EmitAsyncDestroy EmitAsyncInit \
		EmitBeforeExit EmitExit EmitProcessBeforeExit EmitProcessExit \
		Encode Environment ErrnoException FatalException \
		FreeArrayBufferAllocator FreeEnvironment FreeIsolateData \
		FreePlatform GetAnonymousMainPath GetArrayBufferAllocator \
		GetCurrentEnvironment GetCurrentEventLoop GetEnvironmentIsolateData \
		GetInspectorParentHandle GetMainContext GetMultiIsolatePlatform \
		GetNodeReport GetTracingController InitializationResultImpl \
		InitializeContext InitializeNodeWithArgs InitializeOncePerProcess \
		InternalCallbackScope IsolateData LoadEnvironment MakeCallback \
		ModuleData MultiIsolatePlatform NewContext NewIsolate \
		NodeArrayBufferAllocator ObjectWrap OnFatalError ParseEncoding \
		PrepareStackTraceCallback ProcessGlobalArgs PromiseRejectCallback \
		RegisterContext RegisterSignalHandler RemoveEnvironmentCleanupHook \
		RemoveEnvironmentCleanupHookInternal RequestInterrupt RunAtExit \
		SetCppgcReference SetIsolateUpForNode SetProcessExitHandler \
		SetTracingController ShouldAbortOnUncaughtException SnapshotData \
		SpinEventLoop Start StartExecutionCallbackInfoWithModule Stop \
		TearDownOncePerProcess TriggerNodeReport TryEncode UVException \
		UnregisterContext signo_string; do
		_m="${#_e}$_e"
		LDFLAGS="$LDFLAGS --export-prefix=_ZN4node$_m --export-prefix=_ZNK4node$_m"
	done
	# The two public nested names, mangled with both components.
	for _p in "7tracing17TracingController" "6crypto9GetSSLCtx"; do
		LDFLAGS="$LDFLAGS --export-prefix=_ZN4node$_p --export-prefix=_ZNK4node$_p"
	done
	# visorjs-dep-abi: begin (generated, see visorjs-dep-abi.mjs)
	# OpenSSL .num families.
	for _e in \
		ACCESS_ ADMISSIONS_ ADMISSION_ AES_ ASIdOrRange_ \
		ASIdentifierChoice_ ASIdentifiers_ ASN1_ ASRange_ ASYNC_ \
		AUTHORITY_ BASIC_ BF_ BIO_asn1_ BIO_ctrl_ BIO_dump_ BIO_f_ \
		BIO_get_ BIO_meth_ BIO_new_ BIO_s_ BIO_set_ BIO_sock_ BIO_socket_ \
		BN_BLINDING_ BN_CTX_ BN_GENCB_ BN_GF2m_ BN_X931_ BN_generate_ \
		BN_get0_ BN_get_ BN_is_ BN_mod_ BN_nist_ BN_priv_ BN_rand_ BN_set_ \
		BN_signed_ BN_to_ BUF_ CERTIFICATEPOLICIES_ CMAC_ CMS_ContentInfo_ \
		CMS_EnvelopedData_ CMS_ReceiptRequest_ CMS_RecipientInfo_kari_ \
		CMS_RecipientInfo_ktri_ CMS_RecipientInfo_set0_ \
		CMS_SignerInfo_get0_ CMS_add0_ CMS_add1_ CMS_add_ CMS_decrypt_ \
		CMS_digest_ CMS_get0_ CMS_get1_ CMS_signed_ CMS_unsigned_ CONF_ \
		CRL_ CRYPTO_ CTLOG_ CT_ DES_ede3_ DES_set_ DH_ DHparams_ \
		DIRECTORYSTRING_ DISPLAYTEXT_ DIST_ DSA_ DSAparams_ DSO_ ECDSA_ \
		ECPARAMETERS_ ECPKPARAMETERS_ EC_GFp_ EC_GROUP_ EC_KEY_ EC_POINT_ \
		EDIPARTYNAME_ ERR_add_ ERR_get_ ERR_load_ ERR_peek_ ERR_print_ \
		ERR_set_ ESS_ EVP_ASYM_ EVP_CIPHER_ EVP_CipherInit_ EVP_ENCODE_ \
		EVP_KDF_ EVP_KEM_ EVP_KEYEXCH_ EVP_KEYMGMT_ EVP_MAC_ EVP_MD_ \
		EVP_PBE_ EVP_PKEY_ EVP_RAND_ EVP_SIGNATURE_ EVP_SKEYMGMT_ \
		EVP_SKEY_ EVP_add_ EVP_aria_ EVP_camellia_ EVP_get_ EVP_seed_ \
		EVP_sha3_ EVP_sm4_ EXTENDED_ GENERAL_ HMAC_ IDEA_ IPAddressChoice_ \
		IPAddressFamily_ IPAddressOrRange_ IPAddressRange_ ISSUER_ \
		ISSUING_ MD4_ MD5_ MDC2_ NAME_ NAMING_ NCONF_ NETSCAPE_CERT_ \
		NETSCAPE_SPKAC_ NETSCAPE_SPKI_ NOTICEREF_ OBJ_NAME_ OCSP_ \
		OPENSSL_INIT_ OPENSSL_LH_ OPENSSL_fork_ OPENSSL_sk_ \
		OPENSSL_version_ OSSL_AA_ OSSL_ALLOWED_ OSSL_ATAV_ \
		OSSL_ATTRIBUTES_ OSSL_ATTRIBUTE_ OSSL_AUTHORITY_ OSSL_BASIC_ \
		OSSL_CMP_ATAVS_ OSSL_CMP_ATAV_ OSSL_CMP_CTX_ OSSL_CMP_HDR_ \
		OSSL_CMP_ITAV_get0_ OSSL_CMP_ITAV_new0_ OSSL_CMP_ITAV_new_ \
