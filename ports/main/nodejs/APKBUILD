# Maintainer: visorjs <info@visorjs.com>
pkgname=nodejs
# Note: Update only to LTS versions! Other versions are supported only for
#  9 months by upstream.
pkgver=24.18.1
pkgrel=172
pkgdesc="JavaScript runtime built on V8 engine - LTS version"
# Inert on the release path: DEV_BUILD is set only by ports/dev.sh, so with it
# unset this expands to nothing and the release apk's metadata is unchanged.
pkgdesc="$pkgdesc${DEV_BUILD:+ [DEV INCREMENTAL BUILD]}"
url="https://nodejs.org/"
arch="wasm64"
license="MIT"
# aports' ca-certificates, and --openssl-use-def-ca-store with it: this
# platform has no system trust store yet, so node uses its bundled roots.
# The v8 device class is declared OPTIONAL at the link (see build()): the
# shim is built without SpiderMonkey, so the host engine behind that class
# is the only engine this binary has, and a boot serving no v8 device gets
# one line saying so and exit 1 rather than a loader refusal. No grant is
# listed here, and `depends="visor-device-v8=2"` would be wrong: the boot
# registry is the only source of a grant, so the solver would refuse
# `apk add nodejs` outright on a boot that registers none.
# What is named below is what the binary still reaches for at runtime,
# with the musl floor tracedeps cannot add:
# aports' unbundled shared-library set is gone because this build links
# those libraries from their -static subpackages (see _stage_deps), leaving
# libc and the C++ runtime as the only NEEDED entries; icu-data stays
# because --with-icu-default-data-dir reads the .dat off the filesystem.
#
# icu-data-full, not the icu-data virtual: apk resolves that virtual to
# icu-data-en on provider_priority, and English-only data would let the
# engine's ECMA-402 claim locales it cannot actually format -- the same
# "advertise what you do not have" bug that no Intl at all was.
depends="musl>=1.2.6-r28 libcxx icu-data-full v8-shim"
# The -dev package's tie back to the main one, named as the siblings do.
depends_dev="$pkgname=$pkgver-r$pkgrel"
# Host tools only: the wasm64 headers arrive from the sibling .apks
# (_stage_deps), and the sysroot carries its own linux/* headers, so aports'
# matching -dev set and linux-headers have no counterpart. samurai is out
# because the image's own ninja conflicts with it over cmd:ninja.
makedepends="python3 py3-jinja2 linux-headers"
install="$pkgname.post-upgrade"
# aports' $pkgname-libs and nodejs.pc are absent: this build links no
# libnode.so, and addons bind to the executable as on Linux.
subpackages="
	$pkgname-dev
	$pkgname-doc
	"
provider_priority=100  # highest priority (other provider is nodejs-current)
provides="nodejs-lts=$pkgver-r$pkgrel"  # for backward compatibility
replaces="nodejs-current nodejs-lts"  # nodejs-lts for backward compatibility
options="!check !strip !archcheck"
source="https://nodejs.org/dist/v$pkgver/node-v$pkgver.tar.gz
	remove-unused-openssl-config.patch
	v8-ppc64le-compat.patch
	v8-riscv-trap-handler.patch
	v8-no-static-zlib.patch
	v8-disable-trap-handler-on-riscv-sv39.patch
	v8-int64-lowering-reducer.patch
	v8-ppc_vsx-inl.patch
	node_sea.patch
	node_snapshotable.patch
	0001-v8-local-handle-data-downcast.patch
	0002-inspector-stub-register-func-signature.patch
	v8-use-visor-shim.patch
	node-gyp-no-latomic.patch
	node-gyp-no-text-start.patch
	node-gyp-js2c-host-deps.patch
	configure-shared-libs-target-only.patch
	abseil-gyp-drop-unbuildable-sources.patch
	abseil-config-wasm-has-mmap.patch
	uv-gyp-no-x86-cpu-relax.patch
	uv-visorjs-spawn-primitive.patch
	uv-guest-time-census.patch
	uv-visorjs-fs-inline.patch
	node-guest-time-census.patch
	node-visorjs-microtask-drain-in-callback-scope.patch
	uv-visorjs-poll-yield.patch
	node-visorjs-arena-accounting.patch
	common-gypi-wasm64-addons.patch
	node-api-headers-emscripten-only.patch
	node-visorjs-addon-register-trampoline.patch
	uv-visorjs-after-work-arity.patch
	node-visorjs-unwind-state.patch
	node-visorjs-wasm-dead-imports.patch
	"
builddir="$srcdir/node-v$pkgver"

