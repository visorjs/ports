		i2d_OSSL_CRMF_MSG i2d_OSSL_CRMF_MSGS i2d_OSSL_CRMF_PBMPARAMETER \
		i2d_OSSL_CRMF_PKIPUBLICATIONINFO i2d_OSSL_CRMF_SINGLEPUBINFO \
		i2d_OSSL_DAY_TIME i2d_OSSL_DAY_TIME_BAND i2d_OSSL_HASH \
		i2d_OSSL_IETF_ATTR_SYNTAX i2d_OSSL_INFO_SYNTAX \
		i2d_OSSL_INFO_SYNTAX_POINTER i2d_OSSL_NAMED_DAY \
		i2d_OSSL_PRIVILEGE_POLICY_ID i2d_OSSL_ROLE_SPEC_CERT_ID \
		i2d_OSSL_ROLE_SPEC_CERT_ID_SYNTAX i2d_OSSL_TARGET \
		i2d_OSSL_TARGETING_INFORMATION i2d_OSSL_TARGETS \
		i2d_OSSL_USER_NOTICE_SYNTAX i2d_OTHERNAME i2d_PBE2PARAM \
		i2d_PBEPARAM i2d_PBKDF2PARAM i2d_PBMAC1PARAM i2d_PKCS12 i2d_PKCS7 \
		i2d_PKCS8PrivateKeyInfo_bio i2d_PKCS8PrivateKeyInfo_fp \
		i2d_PKEY_USAGE_PERIOD i2d_POLICYINFO i2d_POLICYQUALINFO \
		i2d_PROFESSION_INFO i2d_PROXY_CERT_INFO_EXTENSION i2d_PROXY_POLICY \
		i2d_PUBKEY i2d_PUBKEY_bio i2d_PUBKEY_fp i2d_PrivateKey \
		i2d_PrivateKey_bio i2d_PrivateKey_fp i2d_PublicKey \
		i2d_RSAPrivateKey i2d_RSAPrivateKey_bio i2d_RSAPrivateKey_fp \
		i2d_RSAPublicKey i2d_RSAPublicKey_bio i2d_RSAPublicKey_fp \
		i2d_SCRYPT_PARAMS i2d_SCT_LIST i2d_SSL_SESSION i2d_SXNET \
		i2d_SXNETID i2d_USERNOTICE i2d_X509 i2o_ECPublicKey i2o_SCT \
		i2o_SCT_LIST i2t_ASN1_OBJECT o2i_ECPublicKey o2i_SCT o2i_SCT_LIST; do
		LDFLAGS="$LDFLAGS --export-extra=$_e"
	done
	# zlib.h's ZEXTERN functions.
	for _e in \
		adler32 adler32_combine adler32_combine64 adler32_z compress \
		compress2 compress2_z compressBound compressBound_z compress_z \
		crc32 crc32_combine crc32_combine64 crc32_combine_gen \
		crc32_combine_gen64 crc32_combine_op crc32_z deflate deflateBound \
		deflateBound_z deflateCopy deflateEnd deflateGetDictionary \
		deflateInit2_ deflateInit_ deflateParams deflatePending \
		deflatePrime deflateReset deflateResetKeep deflateSetDictionary \
		deflateSetHeader deflateTune deflateUsed get_crc_table gzbuffer \
		gzclearerr gzclose gzclose_r gzclose_w gzdirect gzdopen gzeof \
		gzerror gzflush gzfread gzfwrite gzgetc gzgetc_ gzgets gzoffset \
		gzoffset64 gzopen gzopen64 gzprintf gzputc gzputs gzread gzrewind \
		gzseek gzseek64 gzsetparams gztell gztell64 gzungetc gzvprintf \
		gzwrite inflate inflateBack inflateBackEnd inflateBackInit_ \
		inflateCodesUsed inflateCopy inflateEnd inflateGetDictionary \
		inflateGetHeader inflateInit2_ inflateInit_ inflateMark \
		inflatePrime inflateReset inflateReset2 inflateResetKeep \
		inflateSetDictionary inflateSync inflateSyncPoint inflateUndermine \
		inflateValidate uncompress uncompress2 uncompress2_z uncompress_z \
		zError zlibCompileFlags zlibVersion; do
		LDFLAGS="$LDFLAGS --export-extra=$_e"
	done
	# visorjs-dep-abi: end
	export LDFLAGS
	export LDFLAGS="$LDFLAGS -L$srcdir/deps-staged/usr/lib"
	# As upstream's bundled build: every OpenSSL/zlib member, for addons.
	LDFLAGS="$LDFLAGS -Wl,--whole-archive $srcdir/deps-staged/usr/lib/libcrypto.a"
	LDFLAGS="$LDFLAGS $srcdir/deps-staged/usr/lib/libssl.a"
	LDFLAGS="$LDFLAGS $srcdir/deps-staged/usr/lib/libz.a -Wl,--no-whole-archive"
	# Two archives nothing on node's own link line names, because with the
	# shared build each arrived through another library's NEEDED:
	# libbrotlicommon behind brotlidec/brotlienc, and ICU's stub data
	# library behind libicuuc (icu-uc.pc lists it under Libs.private, which
	# pkg-config only emits for --static). An archive nothing references
	# contributes nothing, so naming them is safe either way.
	LDFLAGS="$LDFLAGS -lbrotlicommon -licudata -lv8_spidermonkey"
	export LDFLAGS
	# gyp reads AR and the _host trio straight from the environment; without
	# them the host toolset would build native tools with the wasm compiler.
	export AR=llvm-ar
	export CC_host=clang CXX_host=clang++ AR_host=llvm-ar
	# --enable-lto reaches the host toolset too, and binutils ld cannot read
	# its bitcode here (no LLVMgold.so); lld can.
	export LDFLAGS_host="-fuse-ld=lld"
	# configure.py resolves each --shared-* through pkg-config, fatally for
	# ICU. LIBDIR replaces the search path so the container's own aarch64 .pc
	# files cannot win; SYSROOT_DIR rewrites their /usr onto the staged tree.
	export PKG_CONFIG_LIBDIR="$srcdir/deps-staged/usr/lib/pkgconfig"
	export PKG_CONFIG_SYSROOT_DIR="$srcdir/deps-staged"

	_build
}

_build() {
	# NOTE: We use bundled libuv because they don't care much about backward
	# compatibility and it has happened several times in past that we
	# couldn't upgrade nodejs package in stable branches to fix CVEs due to
	# libuv incompatibility.
	#
	# NOTE: We don't package the bundled npm - it's a separate project with
	# its own release cycle and version numbering, so it's better to keep
	# it in a standalone aport.
	#
	# The last six switches are this target's. --cross-compiling stops
	# configure running its probes; --dest-os=linux is what makes gyp pick
	# deps/uv's linux source set, matching the -D__linux__ above;
	# --dest-cpu=x64 is the only value whose
	# arch flag (-m64) wasm64 accepts; --without-bundled-v8 collapses the V8
	# build and frees the V8 include path for the shim; the inspector's other
	# half is one of the deps/v8 targets that removes; and the snapshot is
	# made by executing node_mksnapshot, which nothing here can run.
	#
	# Inert on the release path: DEV_BUILD is set only by ports/dev.sh, which
	# keeps out/Release alive between runs. Unset, the test is always false
	# and configure.py + gyp_node.py run exactly as they always did.
	if [ -n "${DEV_BUILD:-}" ] && [ -f out/Release/build.ninja ] &&
		[ -z "${DEV_RECONFIGURE:-}" ]; then
		msg "DEV: reusing existing out/Release/build.ninja"
		make BUILDTYPE=Release NINJA_ARGS=node
		return 0
	fi

	python3 configure.py \
		--prefix=/usr \
		--use-prefix-to-find-headers \
		--ninja \
		--enable-lto \
		--shared-ada \
		--shared-brotli \
		--shared-zlib \
		--shared-openssl \
		--shared-cares \
		--shared-nghttp2 \
		--shared-simdjson \
		--shared-simdutf \
		--shared-sqlite \
		--shared-zstd \
		--with-icu-default-data-dir="$_icu_data_dir" \
		--with-intl=system-icu \
		--without-corepack \
		--without-npm \
		--cross-compiling \
		--dest-os=linux \
		--dest-cpu=x64 \
		--without-bundled-v8 \
		--without-inspector \
		--without-node-snapshot \
		"$@"

	# gyp takes the linker from make_global_settings and nowhere else (LD in
	# the environment is ignored, ld defaults to $cc), and configure.py never
	# populates it. Absolute: gyp path-joins a relative value.
	python3 - <<-EOF
		import json
		p = 'config.gypi'
		s = open(p).read()
		i = s.index('{')
		head, body = s[:i], json.loads(s[i:])
		body['make_global_settings'] = [
		    ['LD', '/usr/local/bin/reactor-link++'],
		    ['LDXX', '/usr/local/bin/reactor-link++'],
		]
		open(p, 'w').write(head + json.dumps(body, indent=2) + '\n')
	EOF
	python3 tools/gyp_node.py --no-parallel -Dconfiguring_node=1 \
		-Dbuild_type=Release -Dpython=/usr/bin/python3 -f ninja-linux

	# NINJA_ARGS narrows aports' bare `make`: ninja's default target includes
	# node's gtest binaries, and googletest declares an operator<< over
	# std::wstring, which this libc++ does not have.
	make BUILDTYPE=Release NINJA_ARGS=node
}

package() {
	make DESTDIR="$pkgdir" install NINJA_ARGS=node

	# Addons target wasm64 and link none of node's build-time settings or libs.
	python3 - "$pkgdir"/usr/include/node/config.gypi <<-'EOF'
		import json, sys
		p = sys.argv[1]
		s = open(p).read()
		i = s.index('{')
		head, body = s[:i], json.loads(s[i:])
		body['variables']['target_arch'] = 'wasm64'
		body.pop('make_global_settings', None)
		d = body['target_defaults']
		d['include_dirs'] = [
		    x for x in d['include_dirs'] if '/deps-staged/' not in x]
		d['libraries'] = [x for x in d['libraries'] if x[:2] not in ('-l', '-L')]
		conds = []
		for cond, branch in d.get('target_conditions', []):
		    libs = [x for x in branch.get('libraries', [])
		            if x[:2] not in ('-l', '-L')]
		    if libs:
		        branch['libraries'] = libs
		    else:
		        branch.pop('libraries', None)
		    if branch:
		        conds.append([cond, branch])
		if conds:
		    d['target_conditions'] = conds
		else:
		    d.pop('target_conditions', None)
		out = json.dumps(body, indent=2)
		if 'deps-staged' in out:
		    sys.exit('config.gypi still names deps-staged')
		open(p, 'w').write(head + out + '\n')
	EOF
}

dev() {
	provides="nodejs-lts-dev=$pkgver"  # for backward compatibility
	default_dev
}

