# Maintainer: visorjs <info@visorjs.com>
pkgname=pkgconf
pkgver=3.0.5
pkgrel=8
pkgdesc="development framework configuration tools"
url="https://github.com/pkgconf/pkgconf"
arch="wasm64"
license="ISC"
depends="musl>=1.2.6-r28"
# Named as well as traced: -dev's libpkgconf.so symlink and .pc resolve
# against the main package's libpkgconf.so.8.
depends_dev="$pkgname=$pkgver-r$pkgrel"
replaces="pkgconfig"
provides="pkgconfig=1"
checkdepends=""
subpackages="$pkgname-doc $pkgname-dev"
options="!check !strip !archcheck"
source="https://distfiles.ariadne.space/pkgconf/pkgconf-$pkgver.tar.xz
	"

# secfixes:
#   1.9.4-r0:
#     - CVE-2023-24056

# aports drives ./configure, which cannot run here — it composes and executes
# its own compile and link lines. Upstream's own meson build is driven instead,
# with aports' configure switches transcribed onto their meson spellings; both
# build systems produce the same install tree. abuild-meson ships with Alpine's
# meson package, which cannot be installed here, so its standard arguments are
# spelled out, as in every meson recipe in this tree. --default-library=both
# reproduces libtool's shared+static default that aports' configure line takes.
build() {
	meson setup \
		--cross-file /usr/local/share/reactor/meson/wasm64-reactor.ini \
		--prefix=/usr --libdir=/usr/lib \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var \
		--buildtype=plain \
		--wrap-mode=nodownload --default-library=both \
		-Db_ndebug=true \
		-Dwith-pkg-config-dir=/usr/local/lib/pkgconfig:/usr/local/share/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	ln -s pkgconf "$pkgdir"/usr/bin/pkg-config
}

dev() {
	default_dev

	# Move pkg-config back to main package (default_dev implicitly moves
	# files /usr/bin/*-config to -dev).
	mv "$subpkgdir"/usr/bin/pkg-config "$pkgdir"/usr/bin/

	mkdir -p "$pkgdir"/usr/share/aclocal/
	mv "$subpkgdir"/usr/share/aclocal/pkg.m4 "$pkgdir"/usr/share/aclocal/
}

sha512sums="
