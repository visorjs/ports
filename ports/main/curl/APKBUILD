# Maintainer: visorjs <info@visorjs.com>
pkgname=curl
pkgver=8.21.0
pkgrel=8
pkgdesc="URL retrieval utility and library"
url="https://curl.se/"
arch="wasm64"
license="curl"
depends="ca-certificates-bundle libcurl=$pkgver-r$pkgrel musl>=1.2.6-r28"
depends_dev="
	brotli-dev
	c-ares-dev
	libidn2-dev
	libpsl-dev
	nghttp2-dev
	openssl-dev
	zlib-dev
	zstd-dev
	$pkgname=$pkgver-r$pkgrel
	"
subpackages="$pkgname-static $pkgname-doc $pkgname-dev libcurl"
options="!check !strip !archcheck"
provides="wcurl=$pkgver-r$pkgrel"
replaces="wcurl"
source="https://curl.se/download/curl-$pkgver.tar.xz"

_stage_deps() {
	local deps="$srcdir/deps-staged"
	apk add --root "$deps" --initdb --no-scripts --no-chown \
		--arch "$CARCH" --keys-dir "${VISORJS_APK_KEYS:-/work/ports/keys}" \
		--repository "$REPODEST/main" \
		musl zlib zlib-dev zstd-libs zstd-dev brotli-libs brotli-dev \
		openssl-dev libcrypto3 libssl3 nghttp2-libs nghttp2-dev \
		c-ares c-ares-dev libidn2 libidn2-dev libunistring libunistring-dev \
		libpsl libpsl-dev pkgconf ca-certificates \
		|| die "staging the dependency root failed"

	export PKG_CONFIG_PATH="$deps/usr/lib/pkgconfig:$deps/usr/share/pkgconfig"
	export PKG_CONFIG_LIBDIR="$deps/usr/lib/pkgconfig:$deps/usr/share/pkgconfig"
	export CFLAGS="$CFLAGS -I$deps/usr/include"
	export CPPFLAGS="$CPPFLAGS -I$deps/usr/include"
	export LDFLAGS="$LDFLAGS -L$deps/usr/lib"
	_deps="$deps"
}

build() {
	_stage_deps

	cmake -B build -G Ninja \
		-DCMAKE_TOOLCHAIN_FILE=/usr/local/share/reactor/cmake/wasm64-reactor.cmake \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_PREFIX_PATH="$_deps/usr" \
		-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
		-DCURL_USE_OPENSSL=ON \
		-DCURL_USE_LIBSSH2=OFF \
		-DCURL_USE_LIBPSL=ON \
		-DCURL_USE_GSSAPI=OFF \
		-DUSE_NGHTTP2=ON \
		-DENABLE_ARES=ON \
		-DCURL_ZLIB=ON \
		-DCURL_ZSTD=ON \
		-DCURL_BROTLI=ON \
		-DUSE_LIBIDN2=ON \
		-DENABLE_UNIX_SOCKETS=ON \
		-DENABLE_IPV6=ON \
		-DCURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
		-DCURL_CA_PATH=/etc/ssl/certs \
		-DBUILD_SHARED_LIBS=ON \
		-DBUILD_STATIC_LIBS=ON \
		-DBUILD_CURL_EXE=ON \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

libcurl() {
	pkgdesc="The multiprotocol file transfer library"
	depends="musl>=1.2.6-r28 libcrypto3 libssl3 zlib zstd-libs brotli-libs nghttp2-libs c-ares libidn2 libpsl libunistring"

	amove usr/lib/libcurl.so.*
}

sha512sums="
