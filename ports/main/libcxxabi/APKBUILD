# Maintainer: visorjs <info@visorjs.com>
pkgname=libcxxabi
pkgver=21.1.8
pkgrel=13
pkgdesc="Low-level support for LLVM's C++ standard library (toolchain sysroot build)"
url="https://libcxxabi.llvm.org"
arch="wasm64"
license="Apache-2.0 WITH LLVM-exception"
options="!check !strip !archcheck"
depends="musl>=1.2.6-r28"

# Packages the toolchain sysroot's libc++abi.so rather than building
# llvm-project, the reasoning ports/main/musl gives for libc.so: this is
# the build every C++ object here links against. No -dev, as musl has none.
build() { :; } # the toolchain sysroot build is the build; packaging only

package() {
	install -D -m755 "$REACTOR_SYSROOT/lib/libc++abi.so" \
		"$pkgdir/usr/lib/libc++abi.so.1"
	# No unversioned symlink: every NEEDED entry that reaches this
	# library — including libc++.so's, whose sysroot link now applies
	# the same soname rewrite reactor-link gives ports links — says
	# libc++abi.so.1. Aports parity: the unversioned name is a -dev
	# convenience, and this port ships no -dev (as musl).
}
